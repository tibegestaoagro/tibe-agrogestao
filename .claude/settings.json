{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/guarda-bash.mjs",
            "timeout": 10,
            "statusMessage": "Conferindo heredoc e alvo do push"
          }
        ]
      },
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/guarda-escrita.mjs",
            "timeout": 10,
            "statusMessage": "Conferindo travessao"
          }
        ]
      }
    ]
  }
}
