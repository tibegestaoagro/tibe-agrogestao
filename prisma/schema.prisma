// Tibé (AgroGestão): schema multi-tenant
// Modelo de dados: PRD seção 4. Isolamento por tenant_id: PRD seção 10.4.
//
// Convenções:
// - Modelos em PascalCase, campos em snake_case (espelham os contratos de API do PRD).
// - Todo modelo de negócio carrega `tenant_id` e é coberto pelo middleware de isolamento
//   (lib/prisma.ts), EXCETO os modelos-filho que herdam o tenant via relação com o pai
//   (AnimalWeightLog, AnimalVaccination, AnimalMovement, CropCycle, PlotInput) e o
//   PlatformUser, que vive fora do isolamento por desenho (PRD seção 4 e 10.4).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────────────────────────
// Enums
// ─────────────────────────────────────────────────────────────

enum TenantPlan {
  campo
  fazenda
  grupo
}

enum TenantStatus {
  trial
  active
  suspended
  canceled
}

enum PlatformRole {
  MASTER_ADMIN
  EQUIPE
}

enum ProfileType {
  fazenda
  prestador
}

// Roles de tenant em MAIÚSCULAS conforme spec 0.6 e contrato POST /api/auth/login.
enum UserRole {
  OWNER
  ADMIN
  OPERADOR
  VISUALIZADOR
}

// `AnimalStatus` foi removido em 2026-08-04 (rebanho por categoria): no
// modelo de lote, `quantity` já diz o que resta, e a diferença entre vendido
// e morto vive em `AnimalMovement.movement_type`.

enum MachineStatus {
  active
  maintenance
  sold
  inactive
  /// Máquina entregue numa permuta (missão 4 do Módulo 31). `sold` não serve:
  /// a tela o mostra como "Vendida", e a máquina dada em troca não foi
  /// vendida. É a mesma razão de `permuta_saida` existir no rebanho.
  negociada
}

// "atrasada" não é um valor aqui: é calculado (pending + due_date no
// passado), nunca gravado. Ver docs/specs/module-27-meu-dia.md, seção 2.3.
enum TaskStatus {
  pending
  completed
  cancelled
}

enum AnimalSex {
  male
  female
}

enum MovementType {
  purchase
  sale
  transfer
  death
}

// ─────────────────────────────────────────────────────────────
// Livro-razão do rebanho (Módulo 30). Ver
// docs/specs/module-30-rebanho-livro-razao.md.

/// Onde os animais estão. A situação é o eixo que permite dizer "são meus,
/// mas não estão aqui". Fase 2 usa evento/pasto_terceiro/boitel/desaparecido.
enum HerdSituation {
  presente
  evento
  pasto_terceiro
  boitel
  confinamento
  desaparecido
}

/// De quem os animais são. `terceiro` só aparece na fase 2 (aluguel de
/// pasto), mas o eixo nasce agora: incluí-lo depois obrigaria a migrar toda
/// movimentação já gravada.
enum HerdOwner {
  proprio
  terceiro
}

/// Os nove primeiros são da fase 1; os sete de baixo entraram na fase 2, por
/// cima, como o comentário original previa.
///
/// Um `retorno_estadia` só para os três casos de volta (pasto de terceiro,
/// boitel, evento): a situação de ORIGEM já diz de onde o animal está
/// voltando, então três tipos diriam a mesma coisa duas vezes. Morte
/// confirmada de um desaparecido reusa `morte`, com origem em `desaparecido`.
enum HerdMovementType {
  saldo_inicial
  nascimento
  compra
  venda
  morte
  transferencia_pasto
  transferencia_fazenda
  mudanca_categoria
  ajuste
  envio_evento
  envio_pasto_terceiro
  envio_boitel
  /// Fase 3 (confinamento próprio). `retorno_estadia` já serve para a volta
  /// de qualquer tipo de estadia: a situação de origem diz de onde o animal
  /// voltou, então um tipo de retorno por destino diria a mesma coisa duas
  /// vezes.
  envio_confinamento
  retorno_estadia
  entrada_terceiro
  saida_terceiro
  desaparecimento
  perda_confirmada
  /// Missão 4 do Módulo 31. Tipos PRÓPRIOS, e não `compra`/`venda`
  /// reaproveitados: uma permuta não é venda, e o extrato do rebanho mostrando
  /// "Venda" de 20 cabeças sem receita nenhuma ligada é o §12.6 quebrado no
  /// lugar em que ele mais importa. O estoque já resolveu assim na missão 2.
  permuta_entrada
  permuta_saida
}

/// O tipo da estadia (fase 2, mais `confinamento` na fase 3). `evento` nasce
/// sem uso: a remessa para leilão é a missão 3 do Módulo 31, e acrescentar
/// valor a enum depois obrigaria a migrar movimentação já gravada. Mesmo
/// motivo de `permuta_entrada` no estoque, e dos próprios eixos de situação e
/// dono, criados na fase 1.
///
/// `confinamento` (fase 3, docs/superpowers/specs/2026-08-31-confinamento-fase-3-do-modulo-30.md)
/// é o confinamento PRÓPRIO do produtor. `boitel` já existia e continua
/// separado: são dois tipos de `ConfinementSite.type`, mas a estadia em si já
/// discriminava por dono/local antes de a tabela existir, e manter os dois
/// valores evita reclassificar toda estadia de boitel já gravada.
enum HerdStayType {
  pasto_terceiro
  boitel
  evento
  terceiro_na_fazenda
  desaparecimento
  confinamento
}

/// Como o terceiro cobra pela estadia. É informação do acordo, gravada e
/// mostrada: NÃO entra em cálculo nenhum. O documento do cliente não define a
/// fórmula (mês cheio ou proporcional? conta o dia da saída?), e fórmula
/// inventada gera dinheiro errado em silêncio, que é o pior modo de falha
/// deste produto. O valor lançado é o que o produtor digitar.
///
/// As seis formas do §15 do documento do cliente estão todas aqui desde
/// 31/08 (`por_dia` e `por_cabeca_dia` entraram por último). A ausência de
/// cálculo automático é decisão mantida, não esquecimento: nenhum valor
/// existente muda de significado com a adição.
enum HerdChargeType {
  por_cabeca
  por_mes
  por_periodo
  fechado
  por_dia
  por_cabeca_dia
}

// ─────────────────────────────────────────────────────────────
// Estoque de produtos (Módulo 31, missão 2). Ver §9 e §10 do
// documento do cliente e docs/specs/module-31-negociacoes.md.

/// Como o estoque se mexe (§10.1).
///
/// `permuta_entrada` e `permuta_saida` nascem aqui mesmo sem terem uso ainda:
/// a permuta é a missão 4, e acrescentar valor a um enum depois obrigaria a
/// migrar movimentação já gravada. Mesmo motivo pelo qual os eixos de dono e
/// situação do rebanho nasceram na fase 1.
enum StockMovementType {
  compra
  venda
  utilizacao
  ajuste
  permuta_entrada
  permuta_saida
}

enum CropCycleStatus {
  planted
  growing
  harvested
}

enum InputType {
  fertilizer
  pesticide
  seed
}

enum PricingType {
  hour
  day
  fixed
}

enum ServiceOrderStatus {
  scheduled
  completed
  invoiced
}

enum EntryType {
  income
  expense
}

enum RelatedModule {
  rebanho
  lavoura
  servico
  maquinas
  geral
  /// Fase 3 do Módulo 30 (confinamento). Valor próprio, e não `rebanho`
  /// reaproveitado: o custo do lote confinado (§13, §24 da spec) precisa ser
  /// somável separado do resto do rebanho, e reaproveitar `rebanho` misturaria
  /// as duas somas.
  confinamento
  /// Fase 2 do Módulo 32 (Área Leite). Nasce com a receita do §22 (cobrar pelo
  /// serviço de ponto de coleta) e recebe a venda de leite na fase 3. Valor
  /// próprio pelo mesmo motivo de `confinamento`: o dinheiro do leite precisa
  /// ser somável separado do rebanho, e o §32 pede a área alimentando o
  /// Financeiro como atividade distinta.
  leite
  /// Fase 33.1 (Mão de Obra). Valor próprio pelo mesmo motivo dos dois acima:
  /// o §30 do documento do cliente pede o gasto com equipe somável em separado
  /// ("Mão de obra fixa / Mão de obra eventual / Serviços terceirizados"), e
  /// reaproveitar `geral` misturaria o salário com todo o resto que não tem
  /// módulo.
  mao_de_obra
}

enum FinancialEntryStatus {
  pending
  paid
  overdue
  cancelled
}

enum MessageDirection {
  in
  out
}

enum AlertType {
  vaccine_due
  harvest_near
  bill_due
  low_balance
  trial_ending // spec 5.8, não previsto no PRD original: extensão aditiva
  maintenance_due // Módulo 26, 2026-08-04: manutenção de máquina próxima
  task_reminder // Módulo 27, 2026-08-04: lembrete de tarefa, dispara NO DIA marcado
  low_stock // Módulo 31 §10.8: saldo do produto atingiu o mínimo definido
}

enum AlertStatus {
  pending
  sent
  dismissed
}

// Arquitetura 2026-07-29: canal de email (Gmail SMTP em dev, Resend depois
// que o domínio próprio existir), somando ao WhatsApp já existente. Todo
// envio grava uma linha aqui, sucesso ou falha: rastro auditável exigido
// pelo usuário (avisos de fatura/trial precisam de comprovação, não podem
// depender só do WhatsApp).
enum EmailLogType {
  welcome
  alert
  password_reset
}

enum EmailLogStatus {
  sent
  failed
}

// Arquitetura 2026-07-29: recuperação de senha (código de 6 dígitos por
// email ou WhatsApp, escolha do usuário no pedido). Só para User de tenant
// (PlatformUser fica de fora, decisão deliberada: conta sensível demais pra
// self-service, equipe pequena da Pleno Digital).
enum PasswordResetChannel {
  email
  whatsapp
}

enum SubscriptionStatus {
  active
  overdue
  canceled
}

// ─────────────────────────────────────────────────────────────
// Núcleo multi-tenant
// ─────────────────────────────────────────────────────────────

model Tenant {
  id             String       @id @default(cuid())
  name           String
  document       String       @unique // CNPJ ou CPF
  phone          String?
  email          String?
  plan           TenantPlan
  // Tenants criados manualmente pelo painel (spec 2026-07-27) nascem sem
  // plano escolhido pelo cliente: plan carrega um default interno até o
  // cliente confirmar no primeiro login. Tenants do signup público (que já
  // escolhem o plano em /planos antes de criar a conta) nascem com true.
  plan_confirmed Boolean      @default(true)
  status         TenantStatus @default(trial)
  trial_ends_at  DateTime?
  // Arquivamento pelo painel da plataforma (spec 2026-07-27): nunca deleta,
  // mesmo padrão de Property.archived_at (M1). Idempotente.
  archived_at    DateTime?

  // Origem do lead (UTM), PRD seção 4 / v1.1
  lead_source_utm_source   String?
  lead_source_utm_medium   String?
  lead_source_utm_campaign String?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  profiles             TenantProfile[]
  users                User[]
  properties           Property[]
  contacts             Contact[]
  negotiations         Negotiation[]
  product_categories   ProductCategory[]
  products             Product[]
  stock_movements      StockMovement[]
  animal_categories    AnimalCategory[]
  animal_batches       AnimalBatch[]
  machines             Machine[]
  tasks                Task[]
  financial_categories FinancialCategory[]
  alert_preferences    AlertPreference[]
  vaccines             Vaccine[]
  plots                Plot[]
  pastures             Pasture[]
  service_clients      ServiceClient[]
  services             Service[]
  service_orders       ServiceOrder[]
  financial_entries    FinancialEntry[]
  whatsapp_contacts    WhatsAppContact[]
  conversation_logs    AgentConversationLog[]
  agent_requests       AgentRequest[]
  alerts               Alert[]
  email_logs           EmailLog[]
  password_resets      PasswordResetCode[]
  agent_flows          AgentFlowState[]
  refresh_tokens       RefreshToken[]
  push_subscriptions   PushSubscription[]
  herd_movements       HerdMovement[]
  herd_stays           HerdStay[]
  confinement_sites    ConfinementSite[]
  subscription         Subscription?
  milk_groups          MilkGroup[]
  lactation_entries    LactationEntry[]
  milk_productions     MilkProduction[]
  milk_sites           MilkSite[]
  milk_movements       MilkMovement[]
  milk_charges         MilkCharge[]
  workers              Worker[]
  service_jobs         ServiceJob[]
  worker_logs          WorkerLog[]
}

// Equipe da Pleno Digital. NÃO carrega tenant_id: fora do isolamento (PRD 4 / 10.4).
model PlatformUser {
  id            String       @id @default(cuid())
  name          String
  email         String       @unique
  password_hash String
  role          PlatformRole @default(EQUIPE)
  created_at    DateTime     @default(now())
  active        Boolean      @default(true)

  status_changes SubscriptionStatusLog[]
}

model TenantProfile {
  id           String      @id @default(cuid())
  tenant_id    String
  profile_type ProfileType
  active       Boolean     @default(true)
  created_at   DateTime    @default(now())

  tenant Tenant @relation(fields: [tenant_id], references: [id], onDelete: Cascade)

  @@unique([tenant_id, profile_type])
  @@index([tenant_id])
}

model User {
  id                   String   @id @default(cuid())
  tenant_id            String
  name                 String
  // Email globalmente único: o contrato POST /api/auth/login recebe apenas
  // email+senha (sem seletor de tenant), então o email resolve um único usuário.
  email                String   @unique
  password_hash        String
  role                 UserRole @default(OPERADOR)
  phone                String?
  created_at           DateTime @default(now())
  active               Boolean  @default(true)
  must_change_password Boolean  @default(false)

  tenant                    Tenant              @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  whatsapp_contacts         WhatsAppContact[]
  password_resets           PasswordResetCode[]
  agent_flows               AgentFlowState[]
  refresh_tokens            RefreshToken[]
  herd_movements            HerdMovement[]
  herd_stays                HerdStay[]
  negotiations              Negotiation[]       @relation("NegotiationRecordedBy")
  negotiations_canceled     Negotiation[]       @relation("NegotiationCanceledBy")
  stock_movements           StockMovement[]     @relation("StockRecordedBy")
  push_subscriptions        PushSubscription[]
  financial_entries_created FinancialEntry[]    @relation("FinancialEntryCreatedBy")
  financial_entries_updated FinancialEntry[]    @relation("FinancialEntryUpdatedBy")
  workers_recorded          Worker[]            @relation("WorkerRecordedBy")
  service_jobs_recorded     ServiceJob[]        @relation("ServiceJobRecordedBy")
  service_jobs_canceled     ServiceJob[]        @relation("ServiceJobCanceledBy")

  @@index([tenant_id])
}

// Sessão do aplicativo (identidade por token, Onda 1). O access token é um JWT
// curto (15 min) que NÃO é persistido; só o refresh token vive aqui, e só como
// hash: o valor em claro existe uma única vez, na resposta ao aplicativo.
//
// `tenant_id` está aqui pelo mesmo motivo dos demais modelos de negócio
// (defense-in-depth: entra em TENANT_SCOPED_MODELS), NÃO para servir de
// autoridade de tenant ao autenticar. Quem responde "de qual tenant é esta
// requisição" continua sendo a linha de `User` resolvida pelo `user_id`.
//
// `token_hash` é único: é por ele que a renovação encontra a linha antes de
// saber o tenant, e é o índice que sustenta o uso único (revoked_at).
model RefreshToken {
  id         String    @id @default(cuid())
  tenant_id  String
  user_id    String
  token_hash String    @unique
  expires_at DateTime
  revoked_at DateTime?
  created_at DateTime  @default(now())

  tenant Tenant @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([tenant_id])
  @@index([user_id])
}

// Recuperação de senha (arquitetura 2026-07-29). code_hash: nunca em claro,
// mesmo padrão de senha (bcrypt). O próprio `id` (cuid, não-adivinhável) é a
// referência que a UI carrega entre as 3 telas (pedir → validar → nova
// senha), sem precisar de um token assinado à parte. `verified_at` prova que
// a etapa de validação aconteceu antes de aceitar a troca de senha;
// `consumed_at` fecha o ciclo e impede reuso do mesmo código já validado.
model PasswordResetCode {
  id          String               @id @default(cuid())
  tenant_id   String
  user_id     String
  code_hash   String
  channel     PasswordResetChannel
  attempts    Int                  @default(0)
  verified_at DateTime?
  consumed_at DateTime?
  expires_at  DateTime
  created_at  DateTime             @default(now())

  tenant Tenant @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([tenant_id])
  @@index([user_id])
}

// Cadastro público em andamento (Módulo 19). FORA de TENANT_SCOPED_MODELS por
// necessidade estrutural: o Tenant ainda não existe quando a linha nasce, e é
// justamente esse o ponto (cadastro abandonado não pode virar tenant nem travar
// o CPF/CNPJ do dono real). Mesma categoria de PlatformUser e
// WhatsAppProviderConfig. Toda leitura é pelo `id` da própria linha, entregue
// ao navegador por cookie httpOnly, nunca por email/telefone vindo do client.
model PendingSignup {
  id           String     @id @default(cuid())
  company_name String
  owner_name   String
  owner_email  String
  document     String
  phone        String
  plan         TenantPlan

  whatsapp_code_hash       String
  whatsapp_code_expires_at DateTime
  whatsapp_attempts        Int       @default(0)
  whatsapp_verified_at     DateTime?

  email_code_hash       String?
  email_code_expires_at DateTime?
  email_attempts        Int       @default(0)
  email_verified_at     DateTime?

  utm_source   String?
  utm_medium   String?
  utm_campaign String?

  created_at DateTime @default(now())
  expires_at DateTime

  @@index([document])
  @@index([expires_at])
}

// Cadastro assistido em andamento pelo WhatsApp (2026-07-30). Existe porque o
// agente era SEM ESTADO: o contexto vinha do `recent_history` (5 interacoes), o
// que sustenta um "sim/nao" mas nao um formulario de varios campos vezes varios
// animais, onde a primeira resposta sai da janela antes do fim.
//
// Nada e gravado no rebanho antes da confirmacao final: os itens ficam aqui, em
// `completed_items`, e so viram lote quando o usuario confirma o resumo. O
// risco de perder trabalho no meio e coberto pelo lembrete de abandono, que le
// `updated_at` e `reminded_at`.
model AgentFlowState {
  id               String    @id @default(cuid())
  tenant_id        String
  user_id          String
  flow             String
  target_count     Int       @default(1)
  completed_items  Json      @default("[]")
  current_item     Json      @default("{}")
  pending_field    String?
  awaiting_summary Boolean   @default(false)
  reminded_at      DateTime?
  expires_at       DateTime
  created_at       DateTime  @default(now())
  updated_at       DateTime  @updatedAt

  tenant Tenant @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [user_id], references: [id], onDelete: Cascade)

  // Um cadastro em andamento por usuario: dois formularios paralelos na mesma
  // conversa de texto seriam impossiveis de acompanhar.
  @@unique([tenant_id, user_id])
  @@index([tenant_id])
  @@index([expires_at])
}

model Property {
  id            String    @id @default(cuid())
  tenant_id     String
  name          String
  address       String?
  // city/district = município/distrito (Módulo 29, "Minha Fazenda"): nullable
  // no banco porque propriedades já existentes não têm valor; obrigatório só
  // na validação de criação (Zod), não no schema, pra não quebrar dado real.
  city          String?
  district      String?
  area_hectares Decimal?  @db.Decimal(12, 2)
  archived_at   DateTime? // arquivamento (1.1): não deletar, preservar histórico
  created_at    DateTime  @default(now())

  tenant          Tenant           @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  animal_batches  AnimalBatch[]
  machines        Machine[]
  stock_movements StockMovement[]
  plots           Plot[]
  pastures        Pasture[]
  negotiations    Negotiation[]
  movements_from  AnimalMovement[] @relation("MovementFromProperty")
  movements_to    AnimalMovement[] @relation("MovementToProperty")

  /// Livro-razão do rebanho (Módulo 30). Nomes diferentes dos de cima porque
  /// `AnimalMovement` é o modelo ANTIGO, que continua existindo.
  herd_movements_from HerdMovement[] @relation("HerdMovementFromProperty")
  herd_movements_to   HerdMovement[] @relation("HerdMovementToProperty")
  herd_stays          HerdStay[]

  /// Fase 3 do Módulo 30 (confinamento próprio). `Restrict` no filho, mesmo
  /// motivo do resto deste modelo: propriedade é arquivada, nunca apagada.
  confinement_sites ConfinementSite[]

  /// Área Leite, fase 1 (Módulo 32). `Restrict` no filho pelo mesmo motivo do
  /// resto deste modelo: propriedade é arquivada, nunca apagada.
  milk_groups       MilkGroup[]
  lactation_entries LactationEntry[]
  milk_productions  MilkProduction[]
  milk_sites        MilkSite[]
  workers           Worker[]
  service_jobs      ServiceJob[]
  worker_logs       WorkerLog[]

  @@index([tenant_id])
}

// Módulo 29 ("Minha Fazenda"): divisão da propriedade em áreas de pastagem,
// conforme docs/Minha Fazenda — Especificação Funcional.doc. Entidade nova,
// sem relação com Plot/"Talhão" (que é do domínio de Lavoura/CropCycle):
// mesma forma superficial ("área dentro de uma propriedade"), domínios
// diferentes, não conflatar. V1 é só cadastro (nome + tamanho); vínculos
// futuros com Task/FinancialEntry (seção 9 do documento) ficam de fora
// deliberadamente por decisão do usuário (2026-08-04).
/// Categoria de produto (§9.1). Tabela POR TENANT, não constante de código.
///
/// Diferente das 12 categorias do rebanho, que são constante em
/// `src/lib/herd/categories.ts` porque carregam sexo, faixa etária e flag de
/// reprodutiva, e sem isso "total de machos" e o envelhecimento não seriam
/// calculáveis. Categoria de produto não carrega semântica nenhuma: é rótulo,
/// e o produtor precisa poder acrescentar o dele ("Herbicida", "Arame liso").
///
/// As 15 do §9.1 nascem na primeira vez que o tenant abre o Estoque (decisão
/// do usuário, 2026-08-14): sem migração de dado, e um tenant que apagar todas
/// não fica travado.
model ProductCategory {
  id          String    @id @default(cuid())
  tenant_id   String
  name        String
  archived_at DateTime?
  created_at  DateTime  @default(now())

  tenant   Tenant    @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  products Product[]

  @@unique([tenant_id, name])
  @@index([tenant_id])
}

/// O produto em si (§9.2 e §9.3). É catálogo do tenant, não da fazenda: o
/// SALDO é que vive por fazenda, na soma das movimentações.
model Product {
  id               String    @id @default(cuid())
  tenant_id        String
  category_id      String
  name             String
  /// Constante de código (`src/lib/stock/units.ts`), não tabela: as 11 do
  /// §10.5 são vocabulário fechado, e "saca" precisa significar a mesma coisa
  /// em todo tenant para o saldo ser comparável.
  unit             String
  brand            String?
  /// §10.8: quando o saldo atinge este limite, o alerta dispara. Nulo = sem
  /// alerta para este produto.
  minimum_stock    Decimal?  @db.Decimal(14, 3)
  storage_location String?
  notes            String?
  archived_at      DateTime?
  created_at       DateTime  @default(now())
  updated_at       DateTime  @updatedAt

  tenant    Tenant          @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  category  ProductCategory @relation(fields: [category_id], references: [id], onDelete: Restrict)
  movements StockMovement[]

  @@unique([tenant_id, name])
  @@index([tenant_id])
  @@index([category_id])
}

/// O livro-razão do estoque (§10).
///
/// **O saldo NUNCA é gravado**: é a soma de `quantity` das movimentações não
/// canceladas, por produto e fazenda. Mesma regra do rebanho, e pelo mesmo
/// motivo: um campo de saldo e uma soma de movimentações são duas verdades, e
/// no dia em que discordarem ninguém sabe qual está certa.
///
/// `quantity` é SEMPRE positiva; quem decide o sinal é o `movement_type`.
/// Guardar negativo faria a leitura depender de lembrar a convenção.
model StockMovement {
  id            String            @id @default(cuid())
  tenant_id     String
  product_id    String
  property_id   String
  movement_type StockMovementType
  /// §10.5: aceita parcial ("0,5 saca"), então decimal, nunca inteiro.
  quantity      Decimal           @db.Decimal(14, 3)
  occurred_at   DateTime

  /// §10.6: o ajuste registra o saldo anterior e o corrigido, não só a
  /// diferença. Sem isso o histórico não explica o que o produtor viu quando
  /// decidiu corrigir.
  previous_balance  Decimal? @db.Decimal(14, 3)
  corrected_balance Decimal? @db.Decimal(14, 3)

  /// §10.4, opcional: para qual grupo de animais o produto foi usado. Aponta
  /// para a CATEGORIA do rebanho (decisão do usuário, 2026-08-14), que é o
  /// mais próximo de "grupo" que existe hoje e já é vocabulário do produtor.
  herd_category_id String?
  pasture_id       String?
  purpose          String?

  notes               String?
  negotiation_id      String?
  recorded_by_user_id String?

  /// Fase 3 do Módulo 30 (confinamento, §11 da spec): a "utilização deverá
  /// ficar vinculada ao confinamento". Aponta para a `HerdStay` que consumiu o
  /// produto. Opcional: nem toda saída de estoque é alimentação de
  /// confinamento, e a soma do custo do lote (§13, §24) lê só o que estiver
  /// ligado, nunca estimativa.
  stay_id String?

  canceled_at     DateTime?
  canceled_reason String?
  created_at      DateTime  @default(now())

  tenant      Tenant       @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  product     Product      @relation(fields: [product_id], references: [id], onDelete: Restrict)
  property    Property     @relation(fields: [property_id], references: [id], onDelete: Cascade)
  pasture     Pasture?     @relation(fields: [pasture_id], references: [id], onDelete: SetNull)
  negotiation Negotiation? @relation(fields: [negotiation_id], references: [id], onDelete: SetNull)
  recorded_by User?        @relation("StockRecordedBy", fields: [recorded_by_user_id], references: [id], onDelete: SetNull)
  stay        HerdStay?    @relation(fields: [stay_id], references: [id], onDelete: SetNull)

  @@index([tenant_id])
  @@index([tenant_id, product_id, property_id])
  @@index([product_id])
  @@index([negotiation_id])
  @@index([stay_id])
  /// Mesmo motivo do índice equivalente em `HerdMovement`: `getStockBalance`
  /// sempre filtra por movimentação não cancelada.
  @@index([tenant_id, canceled_at])
}

model Pasture {
  id            String    @id @default(cuid())
  tenant_id     String
  property_id   String
  name          String
  area_hectares Decimal   @db.Decimal(12, 2)
  archived_at   DateTime? // "excluir ou desativar um pasto" (doc §5): desativar, nunca deletar
  created_at    DateTime  @default(now())

  tenant          Tenant          @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  stock_movements StockMovement[]
  property        Property        @relation(fields: [property_id], references: [id], onDelete: Restrict)

  herd_movements_from HerdMovement[] @relation("HerdMovementFromPasture")
  herd_movements_to   HerdMovement[] @relation("HerdMovementToPasture")

  /// Área Leite (Módulo 32): o pasto é informação OPCIONAL do registro de
  /// lactação (§4), nunca eixo de saldo. Ver a decisão 4.2 da spec.
  lactation_entries LactationEntry[]
  service_jobs      ServiceJob[]
  worker_logs       WorkerLog[]

  @@index([tenant_id])
  @@index([property_id])
}

// ─────────────────────────────────────────────────────────────
// Módulo Rebanho
// ─────────────────────────────────────────────────────────────

// tenant_id incluído para entrar no middleware de isolamento (decisão M1).
/// Peso de um LOTE numa data. Para lote de várias cabeças é a média; para
/// lote de 1 (quem usa brinco) é o peso daquele animal. Sustenta o GMD.
model AnimalWeightLog {
  id          String   @id @default(cuid())
  tenant_id   String
  batch_id    String
  weight      Decimal  @db.Decimal(10, 3)
  measured_at DateTime
  created_at  DateTime @default(now())

  batch AnimalBatch @relation(fields: [batch_id], references: [id], onDelete: Cascade)

  @@index([tenant_id])
  @@index([batch_id])
}

model Vaccine {
  id                    String @id @default(cuid())
  tenant_id             String
  name                  String
  default_interval_days Int?

  tenant       Tenant              @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  vaccinations AnimalVaccination[]

  @@index([tenant_id])
}

// tenant_id incluído para entrar no middleware de isolamento (decisão M1).
model AnimalVaccination {
  id          String    @id @default(cuid())
  tenant_id   String
  batch_id    String
  vaccine_id  String
  applied_at  DateTime
  next_due_at DateTime?
  cost        Decimal?  @db.Decimal(14, 2) // custo opcional → gera FinancialEntry (1.4/1.6)
  created_at  DateTime  @default(now())

  batch   AnimalBatch @relation(fields: [batch_id], references: [id], onDelete: Cascade)
  vaccine Vaccine     @relation(fields: [vaccine_id], references: [id], onDelete: Restrict)

  @@index([tenant_id])
  @@index([batch_id])
  @@index([vaccine_id])
}

// tenant_id incluído para entrar no middleware de isolamento (decisão M1).
model AnimalMovement {
  id               String       @id @default(cuid())
  tenant_id        String
  batch_id         String
  /// Quantas cabeças se moveram. No modelo de lote, vender 5 de 20 é um
  /// movimento de 5: sem isto, a evolução do rebanho não teria como subtrair
  /// a saída parcial. Migrações do modelo antigo (1 linha por cabeça) valem 1.
  quantity         Int          @default(1)
  movement_type    MovementType
  from_property_id String?
  to_property_id   String?
  value            Decimal?     @db.Decimal(14, 2)
  notes            String?
  occurred_at      DateTime
  created_at       DateTime     @default(now())

  batch         AnimalBatch @relation(fields: [batch_id], references: [id], onDelete: Cascade)
  from_property Property?   @relation("MovementFromProperty", fields: [from_property_id], references: [id], onDelete: SetNull)
  to_property   Property?   @relation("MovementToProperty", fields: [to_property_id], references: [id], onDelete: SetNull)

  @@index([tenant_id])
  @@index([batch_id])
}

// ─────────────────────────────────────────────────────────────
// Rebanho por categoria e quantidade (Módulo 25, 2026-08-03; virou o modelo
// ÚNICO em 2026-08-04).
//
// Cobre o caso de uso do documento da Agromax ("comprei 20 bezerros") sem
// exigir identificação individual, e agora também o caso de quem usa brinco
// (lote de 1 cabeça com `ear_tag` preenchido). Cada aquisição gera um
// AnimalBatch novo (nunca acumula numa linha existente da mesma categoria),
// o que preserva o custo de cada compra separadamente; venda decrementa
// FIFO entre lotes da mesma categoria (mais antigo primeiro), sem escolha
// do usuário. Sem peso individual, GMD, vacina, agenda ou histórico de
// movimentação por lote nesta rodada: ver docs/specs/module-25-rebanho-por-categoria.md.
// ─────────────────────────────────────────────────────────────

model AnimalCategory {
  id         String   @id @default(cuid())
  tenant_id  String
  name       String
  active     Boolean  @default(true)
  created_at DateTime @default(now())

  tenant  Tenant        @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  batches AnimalBatch[]

  @@unique([tenant_id, name])
  @@index([tenant_id])
}

// quantity = 0 não apaga o lote: mantém o histórico de que existiu e foi
// totalmente vendido/consumido (mesmo espírito de Property.archived_at).
/// Modelo ÚNICO de rebanho (2026-08-04). Antes existiam dois caminhos
/// paralelos: `Animal` (uma linha por cabeça, brinco obrigatório) e
/// `AnimalBatch` (categoria + quantidade). O produtor tinha dois jeitos de
/// cadastrar boi, com telas e regras diferentes. Agora tudo é lote por
/// categoria, e o brinco é OPCIONAL: quem trabalha com brinco cadastra um
/// lote de 1 cabeça e preenche o campo.
///
/// `ear_tag` é único por tenant apenas QUANDO PREENCHIDO, via índice único
/// parcial escrito à mão na migração (o Prisma não representa índice parcial,
/// então todo `migrate diff` vai sugerir apagá-lo: ver aviso no CLAUDE.md).
model AnimalBatch {
  id               String     @id @default(cuid())
  tenant_id        String
  property_id      String
  category_id      String
  quantity         Int
  /// Opcional: só para quem trabalha com brinco (lote de 1 cabeça).
  ear_tag          String?
  breed            String?
  /// Opcional: um lote de 20 cabeças pode ser misto.
  sex              AnimalSex?
  birth_date       DateTime?
  average_weight   Decimal?   @db.Decimal(10, 3)
  acquisition_cost Decimal?   @db.Decimal(14, 2)
  acquired_at      DateTime   @default(now())
  created_at       DateTime   @default(now())
  updated_at       DateTime   @updatedAt

  tenant         Tenant              @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  property       Property            @relation(fields: [property_id], references: [id], onDelete: Restrict)
  category       AnimalCategory      @relation(fields: [category_id], references: [id], onDelete: Restrict)
  weight_logs    AnimalWeightLog[]
  vaccinations   AnimalVaccination[]
  movements      AnimalMovement[]
  herd_movements HerdMovement[]

  @@index([tenant_id])
  @@index([property_id])
  @@index([category_id])
}

// ─────────────────────────────────────────────────────────────
// Máquinas e equipamentos (Módulo 26, 2026-08-04).
//
// `next_maintenance_at` fica denormalizado na própria Machine (atualizado a
// cada manutenção registrada), mesmo padrão de AnimalBatch.average_weight +
// AnimalWeightLog: o pai guarda o valor atual, o filho guarda o histórico.
// Sem cálculo de recorrência por dias/horímetro nesta rodada: a próxima data
// é sempre informada pelo usuário. Ver
// docs/specs/module-26-maquinas-equipamentos.md.
// ─────────────────────────────────────────────────────────────

model Machine {
  id                  String        @id @default(cuid())
  tenant_id           String
  property_id         String
  name                String
  type                String
  brand               String?
  model               String?
  year                Int?
  acquired_at         DateTime?
  acquisition_cost    Decimal?      @db.Decimal(14, 2)
  hour_meter          Decimal?      @db.Decimal(10, 1)
  status              MachineStatus @default(active)
  next_maintenance_at DateTime?
  created_at          DateTime      @default(now())
  updated_at          DateTime      @updatedAt

  /// De qual permuta esta máquina VEIO. Duas colunas e não uma: um trator pode
  /// entrar por uma permuta e sair por outra, meses depois, e com uma coluna
  /// só o cancelamento não saberia qual dos dois vínculos está desfazendo.
  acquired_negotiation_id String?
  /// Por qual permuta esta máquina SAIU.
  disposed_negotiation_id String?

  tenant       Tenant               @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  property     Property             @relation(fields: [property_id], references: [id], onDelete: Restrict)
  maintenances MachineMaintenance[]

  acquired_negotiation Negotiation? @relation("MachineAcquired", fields: [acquired_negotiation_id], references: [id], onDelete: SetNull)
  disposed_negotiation Negotiation? @relation("MachineDisposed", fields: [disposed_negotiation_id], references: [id], onDelete: SetNull)

  /// Fase 34.1: os serviços prestados com esta máquina. Vazio na fase 33.2,
  /// que não aceita `machine_id`.
  service_jobs ServiceJob[]

  @@index([tenant_id])
  @@index([property_id])
  @@index([acquired_negotiation_id])
  @@index([disposed_negotiation_id])
}

// tenant_id incluído para o middleware de isolamento (mesmo padrão de
// AnimalWeightLog): filho de Machine, não tem where próprio de negócio.
model MachineMaintenance {
  id           String    @id @default(cuid())
  tenant_id    String
  machine_id   String
  performed_at DateTime
  description  String
  cost         Decimal?  @db.Decimal(14, 2)
  next_due_at  DateTime?
  created_at   DateTime  @default(now())

  /// §29 do Módulo 33: quem prestou a manutenção (o mecânico, a oficina).
  ///
  /// O serviço em si continua sendo `MachineMaintenance`, e NÃO um
  /// `ServiceJob`: este model já tem data, descrição e custo, e já gera
  /// lançamento financeiro com `related_module: maquinas`. "Mecânico gastou
  /// R$ 800 para consertar o trator" é isto aqui. Dois lugares para a mesma
  /// coisa é o que a decisão 3 da spec existe para evitar, e a decisão 10
  /// aplica de novo.
  contact_id String?

  machine Machine  @relation(fields: [machine_id], references: [id], onDelete: Cascade)
  contact Contact? @relation(fields: [contact_id], references: [id], onDelete: SetNull)

  @@index([tenant_id])
  @@index([machine_id])
  @@index([contact_id])
}

// ─────────────────────────────────────────────────────────────
// Meu Dia: tarefas e compromissos (Módulo 27, 2026-08-04).
//
// Compartilhada dentro do tenant (visível a todo mundo, não privada por
// usuário): `created_by` é só metadado, nunca filtro de visibilidade. Sem
// relação Prisma para User de propósito (mesmo espírito de
// SubscriptionStatusLog.changed_by_platform_user_id): não precisa navegar
// daqui para lá em nenhum fluxo desta rodada. `reminded_at` marca que o
// lembrete do dia já foi gerado (idempotência explícita, além do mecanismo
// de ensureAlert). Ver docs/specs/module-27-meu-dia.md.
// ─────────────────────────────────────────────────────────────

model Task {
  id          String     @id @default(cuid())
  tenant_id   String
  title       String
  due_date    DateTime
  remind      Boolean    @default(true)
  status      TaskStatus @default(pending)
  created_by  String?
  reminded_at DateTime?
  created_at  DateTime   @default(now())
  updated_at  DateTime   @updatedAt

  tenant Tenant @relation(fields: [tenant_id], references: [id], onDelete: Cascade)

  @@index([tenant_id])
  @@index([due_date])
}

// ─────────────────────────────────────────────────────────────
// Módulo Lavoura
// ─────────────────────────────────────────────────────────────

model Plot {
  id            String   @id @default(cuid())
  tenant_id     String
  property_id   String
  name          String
  area_hectares Decimal? @db.Decimal(12, 2)
  current_crop  String?
  created_at    DateTime @default(now())

  tenant   Tenant      @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  property Property    @relation(fields: [property_id], references: [id], onDelete: Restrict)
  cycles   CropCycle[]

  @@index([tenant_id])
  @@index([property_id])
}

// tenant_id incluído para entrar no middleware de isolamento (decisão M1).
model CropCycle {
  id                  String          @id @default(cuid())
  tenant_id           String
  plot_id             String
  crop_name           String
  planted_at          DateTime?
  expected_harvest_at DateTime?
  harvested_at        DateTime?
  yield_amount        Decimal?        @db.Decimal(14, 3)
  yield_unit          String?
  status              CropCycleStatus @default(planted)
  created_at          DateTime        @default(now())

  plot   Plot        @relation(fields: [plot_id], references: [id], onDelete: Cascade)
  inputs PlotInput[]

  @@index([tenant_id])
  @@index([plot_id])
}

// tenant_id incluído para entrar no middleware de isolamento (decisão M1).
model PlotInput {
  id         String    @id @default(cuid())
  tenant_id  String
  cycle_id   String
  input_type InputType
  name       String
  quantity   Decimal?  @db.Decimal(14, 3)
  unit       String?
  cost       Decimal?  @db.Decimal(14, 2)
  applied_at DateTime?
  created_at DateTime  @default(now())

  cycle CropCycle @relation(fields: [cycle_id], references: [id], onDelete: Cascade)

  @@index([tenant_id])
  @@index([cycle_id])
}

// ─────────────────────────────────────────────────────────────
// Módulo Prestador de Serviço
// ─────────────────────────────────────────────────────────────

model ServiceClient {
  id         String   @id @default(cuid())
  tenant_id  String
  name       String
  document   String?
  phone      String?
  email      String?
  notes      String?
  created_at DateTime @default(now())

  tenant         Tenant         @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  service_orders ServiceOrder[]

  @@index([tenant_id])
}

model Service {
  id           String      @id @default(cuid())
  tenant_id    String
  name         String
  pricing_type PricingType
  unit_price   Decimal     @db.Decimal(14, 2)
  created_at   DateTime    @default(now())

  tenant         Tenant         @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  service_orders ServiceOrder[]

  @@index([tenant_id])
}

model ServiceOrder {
  id                String             @id @default(cuid())
  tenant_id         String
  service_client_id String
  service_id        String
  description       String?
  quantity          Decimal?           @db.Decimal(14, 3)
  total_value       Decimal?           @db.Decimal(14, 2)
  performed_at      DateTime?
  status            ServiceOrderStatus @default(scheduled)
  created_at        DateTime           @default(now())

  tenant         Tenant        @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  service_client ServiceClient @relation(fields: [service_client_id], references: [id], onDelete: Restrict)
  service        Service       @relation(fields: [service_id], references: [id], onDelete: Restrict)

  @@index([tenant_id])
  @@index([service_client_id])
  @@index([service_id])
}

// ─────────────────────────────────────────────────────────────
// Módulo Financeiro (compartilhado entre perfis)
// ─────────────────────────────────────────────────────────────

model FinancialEntry {
  id             String               @id @default(cuid())
  tenant_id      String
  entry_type     EntryType
  category       String?
  amount         Decimal              @db.Decimal(14, 2)
  related_module RelatedModule        @default(geral)
  related_id     String?
  due_date       DateTime?
  paid_at        DateTime?
  status         FinancialEntryStatus @default(pending)
  notes          String?
  created_at     DateTime             @default(now())

  /// Negociações: o lançamento nasceu de um negócio. Nulo em tudo que já
  /// existia e em lançamento manual, que continua funcionando igual.
  negotiation_id   String?
  negotiation_role NegotiationEntryRole?

  /// Módulo 33: que TIPO de pagamento de mão de obra é este. Nulo em tudo que
  /// não vem de um `Worker`.
  ///
  /// Coluna própria, e não `category`, pela mesma razão que fez
  /// `negotiation_role` existir: `category` é texto livre que o produtor
  /// renomeia no painel (é a fonte de sugestão do `FinancialCategory`, não uma
  /// FK), e o §9 pede o adiantamento mostrado SEPARADO do pagamento normal. Um
  /// histórico agrupado por string quebraria na primeira renomeação.
  worker_entry_kind WorkerEntryKind?

  /// Auditoria (2026-08-20). Este é o modelo onde o dinheiro é registrado e
  /// editado, e até aqui não dava para responder "quem mudou este lançamento,
  /// e quando": só existia `created_at`. `HerdMovement` já carregava
  /// `recorded_by_user_id` desde o Módulo 30, e a assimetria não tinha razão
  /// de ser.
  ///
  /// Tudo anulável, e sem preencher o que já existe: autor retroativo seria
  /// invenção. O que importa é passar a existir daqui para a frente.
  updated_at         DateTime? @updatedAt
  created_by_user_id String?
  updated_by_user_id String?

  tenant      Tenant       @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  negotiation Negotiation? @relation(fields: [negotiation_id], references: [id], onDelete: SetNull)
  created_by  User?        @relation("FinancialEntryCreatedBy", fields: [created_by_user_id], references: [id], onDelete: SetNull)
  updated_by  User?        @relation("FinancialEntryUpdatedBy", fields: [updated_by_user_id], references: [id], onDelete: SetNull)

  /// O livro-razão do rebanho aponta para cá (`HerdMovement.financial_entry_id`).
  herd_movements HerdMovement[]

  @@index([tenant_id])
  @@index([negotiation_id])
  /// `getCashFlow` filtra por status pago mais a janela de `paid_at`;
  /// `getDre` e `getUpcoming` filtram por `due_date` mais status. Nenhuma das
  /// três colunas aparecia em índice nenhum.
  @@index([tenant_id, status, paid_at])
  @@index([tenant_id, due_date, status])
}

// Módulo 28, 2026-08-04. `category` de FinancialEntry continua texto livre
// de propósito (não vira FK obrigatória: lançamento antigo e os automáticos
// de createLinkedEntry já passam string solta); esta lista é só a fonte da
// sugestão no painel, separada por tipo (receita/despesa).
model FinancialCategory {
  id         String    @id @default(cuid())
  tenant_id  String
  name       String
  entry_type EntryType
  active     Boolean   @default(true)
  created_at DateTime  @default(now())

  tenant Tenant @relation(fields: [tenant_id], references: [id], onDelete: Cascade)

  @@unique([tenant_id, entry_type, name])
  @@index([tenant_id])
}

// ─────────────────────────────────────────────────────────────
// Agente WhatsApp
// ─────────────────────────────────────────────────────────────

model WhatsAppContact {
  id                  String    @id @default(cuid())
  tenant_id           String
  phone               String
  user_id             String?
  last_interaction_at DateTime?
  created_at          DateTime  @default(now())

  tenant Tenant                 @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  user   User?                  @relation(fields: [user_id], references: [id], onDelete: SetNull)
  logs   AgentConversationLog[]

  @@unique([tenant_id, phone])
  @@index([tenant_id])
}

/// Uma execução do agente por mensagem do provider, para que repetir a mesma
/// mensagem não repita a escrita.
///
/// O problema (2026-08-20): `POST /api/internal/whatsapp/execute-action` não
/// tinha idempotência nenhuma. Um retry do n8n, ou uma reexecução manual no
/// painel dele, gravava de novo a mesma venda de gado, o mesmo lançamento
/// financeiro, a mesma saída de estoque. Numa rota que escreve dinheiro.
///
/// A chave é o id da mensagem no provider (o `wamid` do WhatsApp), e NÃO o id
/// de execução do n8n: retry manual cria execução nova, e a chave mudaria
/// junto, sem impedir nada. O `wamid` não muda.
///
/// A resposta fica guardada porque replay precisa devolver o que foi
/// respondido da primeira vez. Devolver outra coisa faria o produtor ver duas
/// respostas diferentes para a mesma frase.
model AgentRequest {
  id                  String   @id @default(cuid())
  tenant_id           String
  /// `wamid` da mensagem que originou a execução.
  provider_message_id String
  intent              String
  /// Corpo devolvido na primeira execução, reenviado em caso de replay.
  response            Json
  created_at          DateTime @default(now())

  tenant Tenant @relation(fields: [tenant_id], references: [id], onDelete: Cascade)

  @@unique([tenant_id, provider_message_id])
  @@index([tenant_id])
}

model AgentConversationLog {
  id                  String           @id @default(cuid())
  tenant_id           String
  whatsapp_contact_id String
  direction           MessageDirection
  message_type        String?
  content             String?
  intent_detected     String?
  action_taken        String?
  created_at          DateTime         @default(now())

  tenant           Tenant          @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  whatsapp_contact WhatsAppContact @relation(fields: [whatsapp_contact_id], references: [id], onDelete: Cascade)

  @@index([tenant_id])
  @@index([whatsapp_contact_id])
}

// ─────────────────────────────────────────────────────────────
// Alertas
// ─────────────────────────────────────────────────────────────

model Alert {
  id             String         @id @default(cuid())
  tenant_id      String
  alert_type     AlertType
  related_module RelatedModule?
  related_id     String?
  message        String
  status         AlertStatus    @default(pending)
  scheduled_for  DateTime?
  sent_at        DateTime?
  created_at     DateTime       @default(now())

  /// Chave de deduplicação, montada pela aplicação em `ensureAlert()` como
  /// `alert_type|related_module|related_id|AAAA-MM-DD`.
  ///
  /// Por que existe (2026-08-20): a idempotência do alerta era prometida na
  /// documentação e implementada como `findFirst` seguido de `create`, que é
  /// racy sob concorrência. Faltava a garantia no banco.
  ///
  /// Por que é uma COLUNA e não um índice único direto sobre os quatro campos:
  /// primeiro, `related_module` e `related_id` são anuláveis, e no Postgres
  /// NULL não colide em índice único, então a constraint existiria sem
  /// proteger nada, em silêncio. Segundo, a janela de um dia precisa entrar na
  /// chave, e índice sobre expressão não é representável no `schema.prisma`.
  ///
  /// Por que a janela é de UM DIA, e não unicidade eterna (decisão do usuário,
  /// 2026-08-20): 50 dos 67 alertas são de vacina, que é recorrente. Chave
  /// eterna faria a vacina do próximo ciclo nunca mais ser avisada, e a
  /// constraint tornaria isso irreversível no banco.
  dedup_key String?

  tenant Tenant @relation(fields: [tenant_id], references: [id], onDelete: Cascade)

  @@unique([tenant_id, dedup_key])
  @@index([tenant_id])
}

// Módulo 28, 2026-08-04. Ausência de linha = habilitado (opt-out): só existe
// linha quando alguém desliga um tipo. Por TENANT, não por usuário (mesmo
// nível de findAlertRecipient); por TIPO de alerta, nunca por canal (a
// política de canal do notify(), Onda 2, continua sendo decisão do sistema).
model AlertPreference {
  id         String    @id @default(cuid())
  tenant_id  String
  alert_type AlertType
  enabled    Boolean   @default(false)
  created_at DateTime  @default(now())

  tenant Tenant @relation(fields: [tenant_id], references: [id], onDelete: Cascade)

  @@unique([tenant_id, alert_type])
  @@index([tenant_id])
}

model EmailLog {
  id         String         @id @default(cuid())
  tenant_id  String
  to_email   String
  type       EmailLogType
  related_id String? // Alert.id quando type=alert; null para welcome
  status     EmailLogStatus
  error      String?
  sent_at    DateTime?
  created_at DateTime       @default(now())

  tenant Tenant @relation(fields: [tenant_id], references: [id], onDelete: Cascade)

  @@index([tenant_id])
}

// Inscrição de push web (Onda 2, seam de notificação em src/lib/notify).
// Guarda o necessário para disparar uma notificação via Web Push (RFC 8030):
// endpoint do push service do navegador + as duas chaves da assinatura
// (p256dh, auth). Mais de uma linha por usuário é o caso normal (um
// aparelho = uma inscrição): por isso um alerta pode notificar mais de um
// aparelho do mesmo tenant de uma vez, diferente de WhatsApp/email, que têm
// destinatário único (ver notify() em src/lib/notify/index.ts).
//
// Sem tabela de log de entrega separada: push não tem o mesmo requisito de
// comprovação que WhatsApp/email já cobrem para os alertas críticos (ver
// CLAUDE.md, seção Financeiro e Alertas).
model PushSubscription {
  id         String   @id @default(cuid())
  tenant_id  String
  user_id    String
  endpoint   String   @unique
  p256dh     String
  auth       String
  created_at DateTime @default(now())

  tenant Tenant @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([tenant_id])
  @@index([user_id])
}

// ─────────────────────────────────────────────────────────────
// Cobrança (Asaas)
// ─────────────────────────────────────────────────────────────

model Subscription {
  id                    String             @id @default(cuid())
  tenant_id             String             @unique
  asaas_customer_id     String?
  asaas_subscription_id String?
  plan                  TenantPlan
  status                SubscriptionStatus @default(active)
  next_due_date         DateTime?
  // Quando a assinatura foi cancelada (spec 2026-08-04). Existe porque a
  // janela de arquivamento precisa de uma âncora: quem cancela já vencido
  // não tem período pago a honrar, e aí a contagem dos 60 dias começa no
  // próprio cancelamento. A data também vive em SubscriptionStatusLog, mas
  // ler aquele log em getBillingAccess() custaria uma query no caminho mais
  // quente do app (o layout do dashboard chama a cada render).
  canceled_at           DateTime?
  created_at            DateTime           @default(now())

  tenant      Tenant                  @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  status_logs SubscriptionStatusLog[]

  @@index([tenant_id])
}

// Histórico de toda transição de status de uma assinatura (Módulo 6, task 6.5/
// 6.7/6.9). Não existia até o M6: sem isso, "cancelamentos no período" e
// "tempo médio de conversão trial→pago" são impossíveis de calcular, e a 6.9
// já exigia um log de auditoria para mudança manual de status. Um único
// mecanismo cobre as duas necessidades: toda vez que Subscription.status muda
// (webhook do Asaas OU ação manual de um master_admin), grava-se uma linha
// aqui. changed_by_platform_user_id nulo = mudança automática (webhook).
model SubscriptionStatusLog {
  id                          String              @id @default(cuid())
  subscription_id             String
  from_status                 SubscriptionStatus?
  to_status                   SubscriptionStatus
  changed_by_platform_user_id String?
  reason                      String?
  created_at                  DateTime            @default(now())

  subscription Subscription  @relation(fields: [subscription_id], references: [id], onDelete: Cascade)
  changed_by   PlatformUser? @relation(fields: [changed_by_platform_user_id], references: [id], onDelete: SetNull)

  @@index([subscription_id])
  @@index([to_status])
}

// ─────────────────────────────────────────────────────────────
// Config de provider WhatsApp (spec 2026-07-11): GLOBAL da plataforma,
// fora de TENANT_SCOPED_MODELS (mesma categoria de PlatformUser). Os dois
// providers podem existir configurados em paralelo; no máximo 1 active
// (garantido por transação na ativação + partial unique index na migração).
// credentials_encrypted = JSON criptografado com AES-256-GCM
// (src/lib/crypto-config.ts, chave em CONFIG_ENCRYPTION_KEY).
// ─────────────────────────────────────────────────────────────

enum WhatsAppProvider {
  evolution
  meta_cloud_api
}

model WhatsAppProviderConfig {
  id                    String           @id @default(cuid())
  provider              WhatsAppProvider @unique
  active                Boolean          @default(false)
  credentials_encrypted String
  updated_at            DateTime         @updatedAt
  created_at            DateTime         @default(now())
}

/// Livro-razão do rebanho (Módulo 30). O SALDO NUNCA É GRAVADO: a quantidade
/// de cada posição é a soma das movimentações que entram menos as que saem.
///
/// Uma POSIÇÃO é a interseção de cinco eixos:
///   categoria x fazenda x pasto x situação x dono
///
/// Uma movimentação tira `quantity` cabeças de uma posição (os campos `from_`)
/// e coloca na outra (os campos `to_`). Entrada não tem origem (nascimento,
/// compra, saldo inicial); saída não tem destino (venda, morte); transferência
/// e mudança de categoria têm as duas pontas. É esse formato uniforme que faz
/// a regra de ouro do cliente cair de graça: comparar `from_owner` com
/// `to_owner` responde "ainda é dele?", e `from_situation`/`to_situation`
/// responde "ainda está aqui?".
///
/// `category_id` NÃO é chave estrangeira: aponta para a constante em
/// `src/lib/herd/categories.ts`, deliberadamente (ver spec, seção 3).
model HerdMovement {
  id            String           @id @default(cuid())
  tenant_id     String
  movement_type HerdMovementType
  /// Sempre > 0. O sentido vem de ter origem, destino, ou os dois.
  quantity      Int

  from_category_id String?
  from_property_id String?
  from_pasture_id  String?
  from_situation   HerdSituation?
  from_owner       HerdOwner?

  to_category_id String?
  to_property_id String?
  to_pasture_id  String?
  to_situation   HerdSituation?
  to_owner       HerdOwner?

  /// Valor da compra ou venda. Nascimento e morte nunca têm (§10.4 e §10.5).
  value              Decimal? @db.Decimal(14, 2)
  /// Lançamento financeiro gerado, quando houve valor.
  financial_entry_id String?

  /// Motivo (morte, ajuste) e observação livre: os dois são §10.7.
  reason String?
  notes  String?

  /// §10.7 exige o usuário responsável em toda alteração do rebanho.
  recorded_by_user_id String?

  /// Lote identificado (brinco), quando o produtor usa brinco. Opcional por
  /// desenho: o rebanho é por categoria, e o lote é só detalhe de quem quer.
  batch_id String?

  /// §10.8: cancelar NÃO apaga. A linha continua no histórico, identificada,
  /// e para de contar no saldo. É o que permite conferência depois.
  canceled_at     DateTime?
  canceled_reason String?

  /// Negociações: o movimento nasceu de um negócio. Nulo em nascimento, morte,
  /// transferência e ajuste, que não são negócio nenhum. É por isso que a
  /// Negociação é envelope e não dona: nem todo movimento tem um negócio atrás.
  negotiation_id String?

  /// Fase 2: a estadia que originou o movimento. Nulo em tudo que não é
  /// estadia. Mesmo desenho do `negotiation_id` acima: o FILHO aponta para o
  /// envelope, nunca o contrário, porque nem todo movimento nasce de um.
  stay_id String?

  occurred_at DateTime
  created_at  DateTime @default(now())

  tenant      Tenant       @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  batch       AnimalBatch? @relation(fields: [batch_id], references: [id], onDelete: SetNull)
  recorded_by User?        @relation(fields: [recorded_by_user_id], references: [id], onDelete: SetNull)
  negotiation Negotiation? @relation(fields: [negotiation_id], references: [id], onDelete: SetNull)
  stay        HerdStay?    @relation(fields: [stay_id], references: [id], onDelete: SetNull)

  /// Os eixos de POSIÇÃO ganharam chave estrangeira em 2026-08-20. Antes, o
  /// livro-razão apontava para propriedade e pasto por texto solto: apagar uma
  /// propriedade deixava o histórico do rebanho órfão e o banco não impedia.
  ///
  /// `Restrict` e não `SetNull` porque aqui a referência é o próprio conteúdo
  /// do registro contábil: "saíram 20 da Fazenda A" perde o sentido se a
  /// origem virar nula. Propriedade e pasto neste projeto são ARQUIVADOS
  /// (`archived_at`), nunca apagados, então na prática isto não bloqueia
  /// nenhum fluxo que exista: ele bloqueia o `DELETE` que ninguém deveria
  /// fazer.
  ///
  /// CATEGORIA fica de fora de propósito, e isso não é esquecimento:
  /// `from_category_id`/`to_category_id` guardam CHAVE DE CÓDIGO das 12
  /// categorias (`src/lib/herd/categories.ts`), não id de linha de
  /// `AnimalCategory`. Uma chave estrangeira ali travaria toda linha
  /// existente. Quem valida é `isValidCategory()`.
  from_property Property? @relation("HerdMovementFromProperty", fields: [from_property_id], references: [id], onDelete: Restrict)
  to_property   Property? @relation("HerdMovementToProperty", fields: [to_property_id], references: [id], onDelete: Restrict)
  from_pasture  Pasture?  @relation("HerdMovementFromPasture", fields: [from_pasture_id], references: [id], onDelete: Restrict)
  to_pasture    Pasture?  @relation("HerdMovementToPasture", fields: [to_pasture_id], references: [id], onDelete: Restrict)

  /// `SetNull`, ao contrário dos de cima, porque `cancelMovement()` APAGA
  /// fisicamente a `FinancialEntry` quando ela ainda está pendente
  /// (`herd-ledger.ts`). Com `Restrict`, o cancelamento passaria a falhar.
  /// Com `SetNull`, o banco garante o que o código hoje faz à mão, e passa a
  /// garantir também para as linhas que o código esquecer.
  financial_entry FinancialEntry? @relation(fields: [financial_entry_id], references: [id], onDelete: SetNull)

  @@index([tenant_id])
  @@index([tenant_id, occurred_at])
  @@index([batch_id])
  @@index([negotiation_id])
  /// Toda leitura de saldo (`getPositions`) varre as movimentações não
  /// canceladas do tenant. Índice normal, e não parcial com
  /// `WHERE canceled_at IS NULL`: o parcial seria mais eficiente, mas não é
  /// representável no `schema.prisma`, e este projeto já paga o preço de dois
  /// índices assim, que todo `migrate diff` tenta derrubar como falso drift.
  /// Não vale criar um terceiro.
  @@index([tenant_id, canceled_at])
  @@index([stay_id])
}

/// Cadastro do local de confinamento (fase 3 do Módulo 30, §5 e §29 da spec
/// docs/superpowers/specs/2026-08-31-confinamento-fase-3-do-modulo-30.md).
///
/// Existe porque o boitel (fase 2) guardava local só como texto livre na
/// própria `HerdStay`, e o §25 da spec pede "quantos lotes ativos por local"
/// e o §2 pede "quantos em próprio, quantos em Boitel": as duas perguntas
/// exigem uma linha que sobrevive a mais de uma estadia, não texto repetido.
///
/// Nasce SEM obrigar nada: `HerdStay.confinement_site_id` continua opcional,
/// e as estadias de boitel já gravadas antes desta tabela continuam válidas
/// com o campo nulo. O `counterparty_name` que elas já têm continua sendo a
/// resposta de "onde".
enum ConfinementSiteType {
  proprio
  boitel
}

model ConfinementSite {
  id        String              @id @default(cuid())
  tenant_id String
  name      String
  type      ConfinementSiteType

  /// Fazenda relacionada, quando `type` é `proprio`. Opcional porque um site
  /// `boitel` não é uma fazenda do tenant.
  property_id String?

  /// Empresa ou proprietário, quando `type` é `boitel`. Opcional pelo motivo
  /// espelhado: um site `proprio` não tem contraparte.
  counterparty_name String?
  city              String?
  capacity          Int?
  notes             String?

  archived_at DateTime?
  created_at  DateTime  @default(now())

  tenant   Tenant     @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  property Property?  @relation(fields: [property_id], references: [id], onDelete: Restrict)
  stays    HerdStay[]

  @@index([tenant_id])
  @@index([property_id])
}

/// Uma ESTADIA: as cabeças estão fora do normal, temporariamente, e isso
/// termina. Fase 2 do Módulo 30, ver
/// docs/superpowers/specs/2026-08-27-modulo-30-fase-2-design.md.
///
/// Existe porque o encerramento exige IDENTIDADE. O documento do cliente manda
/// a soma dos destinos (vendidos, retornados, outros) bater com a quantidade
/// enviada, e o saldo por posição não distingue uma remessa de 20 de duas de
/// 10, nem sabe qual delas está sendo encerrada.
///
/// NÃO tem quantidade nem campo de "encerrada", e os dois são deliberados. A
/// quantidade é a soma das movimentações que apontam para cá (invariante 2), e
/// a estadia está aberta enquanto esse saldo for maior que zero: campo gravado
/// e realidade divergem em silêncio, que é a decisão 9 do Módulo 31.
model HerdStay {
  id          String       @id @default(cuid())
  tenant_id   String
  type        HerdStayType
  property_id String

  /// Dono do pasto, nome do boitel, dono dos animais de terceiros. Nulo no
  /// desaparecimento, que não tem contraparte nem lugar.
  counterparty_name String?
  location_name     String?
  city              String?

  /// Data de saída, de entrada, ou o dia em que o sumiço foi percebido.
  started_at      DateTime
  expected_end_at DateTime?

  charge_type  HerdChargeType?
  charge_value Decimal?        @db.Decimal(14, 2)

  /// De qual envelope comercial a estadia nasceu. Só a remessa de evento tem:
  /// pasto de terceiro, boitel e desaparecimento não são negócio. O filho
  /// aponta para o envelope, como em `HerdMovement.negotiation_id`.
  negotiation_id String?

  /// "Tipo do evento" do §8.1: leilão, feira, exposição. Texto livre porque o
  /// documento não fecha a lista, e uma constante nossa recusaria o que o
  /// produtor escrever.
  event_type String?

  /// Motivo provável, que o complemento pede no desaparecimento.
  reason String?
  notes  String?

  recorded_by_user_id String?

  /// Fase 3 (confinamento). Aponta para o `ConfinementSite` cadastrado.
  /// Opcional e sem migração de dado: as estadias de boitel já gravadas antes
  /// desta tabela continuam válidas com o campo nulo, e o `counterparty_name`
  /// que elas já têm continua sendo a resposta de "onde".
  confinement_site_id String?

  /// Cancelar não apaga, como em todo o resto do projeto.
  canceled_at         DateTime?
  canceled_reason     String?
  canceled_by_user_id String?

  created_at DateTime @default(now())

  tenant           Tenant           @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  property         Property         @relation(fields: [property_id], references: [id], onDelete: Restrict)
  recorded_by      User?            @relation(fields: [recorded_by_user_id], references: [id], onDelete: SetNull)
  negotiation      Negotiation?     @relation(fields: [negotiation_id], references: [id], onDelete: SetNull)
  confinement_site ConfinementSite? @relation(fields: [confinement_site_id], references: [id], onDelete: SetNull)
  movements        HerdMovement[]
  stock_movements  StockMovement[]

  /// Fase 33.2: os serviços amarrados a este lote (§27). O custo do lote soma
  /// por aqui, e não por `related_id`, porque o lançamento aponta para o
  /// serviço (decisão 12 da spec).
  service_jobs ServiceJob[]

  @@index([tenant_id, type])
  @@index([tenant_id, started_at])
  @@index([negotiation_id])
  @@index([confinement_site_id])
}

// ─────────────────────────────────────────────────────────────
// Área Negociações (docs/moduloNegociacao). Decisões tomadas com o usuário em
// 2026-08-11, por grilling, 12 perguntas em 3 rodadas.
//
// A DECISÃO CENTRAL: a Negociação é um ENVELOPE COMERCIAL, não a fonte da
// verdade. O "registro único" que o §17.1 pede é exigência de EXPERIÊNCIA
// (preencher um formulário só), não de armazenamento. O saldo do rebanho
// continua sendo a soma de HerdMovement, o do estoque a soma de StockMovement,
// e o dinheiro continua em FinancialEntry. A negociação guarda o que é
// COMERCIAL (com quem, quanto, custos, parcelas) e os filhos apontam para ela.
//
// Por que não o contrário: nem todo movimento nasce de um negócio (nascimento,
// morte e transferência não nascem), então uma Negociação "acima" criaria dois
// caminhos de escrita para a mesma coisa.
// ─────────────────────────────────────────────────────────────

/// §4: o produtor NÃO é obrigado a classificar o contato (o §5 lista o tipo
/// como opcional). Por isso o tipo é
/// opcional, e a primeira versão não pede CPF, CNPJ nem endereço.
enum ContactType {
  particular
  fazendeiro
  comerciante_gado
  frigorifico
  leilao
  feira_evento
  cooperativa
  loja_fornecedor
  prestador_servico
  /// §24 do Módulo 32: os tipos de comprador de leite que faltavam.
  /// `cooperativa` e `particular` a lista já tinha.
  laticinio
  queijaria
  mercado
  outro
}

/// Contraparte de um negócio da fazenda (vendedor, comprador, frigorífico,
/// leiloeira). NÃO é o `ServiceClient`: aquele é cliente de quem PRESTA
/// serviço, vive no perfil prestador, e juntar os dois arrastaria um módulo
/// validado para dentro deste. Decisão do usuário, com o custo aceito de um
/// tenant com os dois perfis cadastrar a mesma pessoa duas vezes.
model Contact {
  id          String       @id @default(cuid())
  tenant_id   String
  name        String
  type        ContactType?
  phone       String?
  city        String?
  notes       String?
  /// Desativar, nunca apagar: mesmo padrão de Property e Pasture.
  archived_at DateTime?
  created_at  DateTime     @default(now())

  tenant       Tenant        @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  negotiations Negotiation[]

  /// Área Leite, fase 2 (§19): o contato é o DONO de um saldo de leite, não só
  /// um rótulo de evento passado. É por isso que o painel escolhe de uma lista
  /// em vez de criar pelo nome digitado, como a negociação faz: aqui "João" e
  /// "Joao" partiriam o leite de um produtor em dois saldos.
  milk_from    MilkMovement[] @relation("MilkMovementFromOwner")
  milk_to      MilkMovement[] @relation("MilkMovementToOwner")
  milk_bought  MilkMovement[] @relation("MilkMovementBuyer")
  milk_charges MilkCharge[]

  /// Fase 33.2: o prestador de um serviço contratado (§19), e o mecânico de
  /// uma manutenção de máquina (§29).
  service_jobs         ServiceJob[]
  machine_maintenances MachineMaintenance[]

  @@index([tenant_id])
}

enum NegotiationType {
  compra_gado
  venda_gado
  compra_produto
  venda_produto
  permuta
  /// Remessa para leilão, feira ou evento (§8). Não é venda: o §17.8 é
  /// explícito que o envio não pode gerar receita antes da confirmação.
  evento
  /// Fase 3 do Módulo 32 (§23 a §29): a venda de leite. Herda parcelas
  /// (§27, recebimento futuro), custos adicionais (o desconto do laticínio) e
  /// cancelamento com estorno, tudo já validado em produção.
  venda_leite
}

/// O envelope comercial. NÃO tem campo de situação: o §16 (em aberto,
/// confirmada, parcialmente paga, paga) é DERIVADO dos filhos, porque campo
/// gravado e realidade divergem em silêncio e o número errado é o que o
/// produtor vê. "Em aberto" nem existe como estado salvo: o §17.2 exige
/// confirmação ANTES de concluir, então nada é gravado sem confirmação.
model Negotiation {
  id          String          @id @default(cuid())
  tenant_id   String
  type        NegotiationType
  occurred_at DateTime
  property_id String
  contact_id  String?

  /// Valor PRINCIPAL do negócio, sem os custos adicionais. É gravado porque é
  /// um dado de entrada (o preço combinado), não uma soma: e porque o §14
  /// exige validar que a soma das parcelas corresponde a ele, o que só é
  /// possível conhecendo-o de forma independente.
  amount Decimal? @db.Decimal(14, 2)

  notes               String?
  recorded_by_user_id String?

  /// O lado da permuta que NÃO tem área no Tibé (serviço, outro): a descrição
  /// do produtor é tudo que existe. Nulos quando o lado é animais, produtos ou
  /// máquina, porque aí quem guarda o quê é o filho.
  barter_out_note String?
  barter_in_note  String?

  /// §17.9: cancelar recalcula tudo. Como o saldo é sempre soma, cancelar aqui
  /// é cancelar os filhos, e a linha permanece no histórico (§17.10).
  canceled_at         DateTime?
  canceled_reason     String?
  /// §17.10 pede "usuário responsável" no histórico. Sem esta coluna, o evento
  /// que mais importa auditar (desfazer um negócio, que mexe em rebanho E
  /// dinheiro) era o único sem autor.
  canceled_by_user_id String?

  created_at DateTime @default(now())

  tenant            Tenant           @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  property          Property         @relation(fields: [property_id], references: [id], onDelete: Cascade)
  contact           Contact?         @relation(fields: [contact_id], references: [id], onDelete: SetNull)
  recorded_by       User?            @relation("NegotiationRecordedBy", fields: [recorded_by_user_id], references: [id], onDelete: SetNull)
  /// §17.10: sem a relação, o campo do usuário responsável podia apontar para
  /// um id que não existe mais, e o nome de quem cancelou não era consultável.
  canceled_by       User?            @relation("NegotiationCanceledBy", fields: [canceled_by_user_id], references: [id], onDelete: SetNull)
  movements         HerdMovement[]
  stock_movements   StockMovement[]
  /// Fase 3 do Módulo 32: as movimentações de leite desta venda ou deste
  /// fechamento. `cancelNegotiation` percorre esta lista, e o que ela faz com
  /// cada linha depende de `created_by_sale`.
  milk_movements    MilkMovement[]
  entries           FinancialEntry[]
  herd_stays        HerdStay[]
  machines_acquired Machine[]        @relation("MachineAcquired")
  machines_disposed Machine[]        @relation("MachineDisposed")

  @@index([tenant_id])
  @@index([tenant_id, occurred_at])
  @@index([contact_id])
}

/// Distingue o lançamento do valor combinado dos custos que vieram junto
/// (§15: frete, comissão, taxa). Sem isso não dá para montar o quadro "valor
/// principal / custos adicionais / líquido" que o documento pede, porque as
/// parcelas do principal também são filhas da mesma negociação.
enum NegotiationEntryRole {
  principal
  custo_adicional
  /// Devolução do dinheiro quando um negócio já pago é cancelado. Lançamento
  /// próprio, com a data em que o dinheiro voltou, em vez de apagar a despesa
  /// original: o dinheiro saiu num mês e voltou em outro, e o DRE dos dois
  /// meses precisa contar essa história como ela aconteceu.
  estorno
}

// ─────────────────────────────────────────────────────────────
// Área Leite, fase 1 (Módulo 32).
// Ver docs/specs/module-32-area-leite.md.
//
// Dois contadores, e NENHUM dos dois é gravado (invariante 2): as vacas em
// lactação são o dobramento dos `LactationEntry`, e os litros de um período
// são a soma dos `MilkProduction`.
//
// Esta área NÃO escreve no livro-razão do rebanho. Nenhuma `HerdMovement`,
// nenhum `AnimalBatch` tocado: "em lactação" é uma CONDIÇÃO, não uma categoria
// (§37.1, §37.2 e §37.4 do documento do cliente). Uma vaca em lactação
// continua contada uma única vez, no lote da categoria dela.
// ─────────────────────────────────────────────────────────────

enum LactationEntryType {
  /// "Estou com 32 vacas dando leite": define o valor absoluto (§4).
  definir
  /// "Entraram mais 4 vacas no leite": soma (§7).
  entrada
  /// "Sequei 3 vacas": subtrai (§7).
  saida
}

enum MilkShift {
  /// §9.1: o número é o dia inteiro, sem detalhar ordenha. NÃO é o mesmo que
  /// turno não informado: ele afirma "isto é o dia todo".
  dia
  manha
  tarde
  noite
}

/// §6: agrupamento leiteiro ("vacas em maior produção", "recém-paridas").
///
/// Model próprio e NÃO o `AnimalBatch`, que é definido por categoria e
/// quantidade. O §37.3 mantém os animais do lote leiteiro nas categorias já
/// definidas no Rebanho, e reusar obrigaria o produtor a fatiar o rebanho por
/// critério de produção, que é o controle complexo que o §1 recusa.
///
/// Não conta cabeça, não duplica animal, não entra em soma nenhuma do Rebanho.
model MilkGroup {
  id          String    @id @default(cuid())
  tenant_id   String
  property_id String
  name        String
  notes       String?
  /// Desativar, nunca apagar: mesmo padrão de Property, Pasture e Contact.
  archived_at DateTime?
  created_at  DateTime  @default(now())

  tenant      Tenant           @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  property    Property         @relation(fields: [property_id], references: [id], onDelete: Restrict)
  lactation   LactationEntry[]
  productions MilkProduction[]

  @@index([tenant_id])
  @@index([property_id])
}

/// §4 e §7. A contagem vigente NUNCA é gravada: é o dobramento destas linhas
/// (a partir do último `definir`, somando entradas e subtraindo saídas).
///
/// A chave do saldo é a FAZENDA, não o lote (decisão 4.2 da spec): o §34 e o
/// §35 mostram um número só, e saldo por lote quebraria "estou com 32 vacas
/// dando leite", que não diz lote nenhum.
model LactationEntry {
  id                  String             @id @default(cuid())
  tenant_id           String
  property_id         String
  type                LactationEntryType
  /// Sempre positivo. O sinal quem dá é o `type`.
  quantity            Int
  recorded_at         DateTime
  notes               String?
  /// §4: informação opcional do registro. Nem pasto nem lote são eixo de saldo.
  pasture_id          String?
  group_id            String?
  /// §37.11: registro errado sai das somas e FICA na lista, marcado. Editar em
  /// cima mudaria a média de um mês fechado sem deixar rastro.
  cancelled_at        DateTime?
  recorded_by_user_id String?
  created_at          DateTime           @default(now())

  tenant   Tenant     @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  property Property   @relation(fields: [property_id], references: [id], onDelete: Restrict)
  pasture  Pasture?   @relation(fields: [pasture_id], references: [id], onDelete: SetNull)
  group    MilkGroup? @relation(fields: [group_id], references: [id], onDelete: SetNull)

  @@index([tenant_id])
  @@index([property_id, recorded_at])
  @@index([group_id])
}

/// §8 e §9. UMA LINHA POR REGISTRO, com turno. A produção do dia é a soma das
/// linhas daquela data, nunca um campo gravado.
///
/// Linha por dia com três colunas foi descartada porque o caminho do WhatsApp
/// chega em pedaços ("tirei 300 de manhã" às nove, "mais 180 à tarde" às
/// cinco): ali o segundo registro viraria uma edição, e o handler passaria a
/// depender de achar a linha certa antes de gravar.
///
/// NÃO tem campo de vacas em lactação, embora o §8 o liste como opcional. Ele
/// vive no formulário e grava um `LactationEntry` do tipo `definir` na mesma
/// transação: gravá-lo aqui criaria uma segunda fonte para o mesmo número, e
/// as duas divergiriam.
model MilkProduction {
  id                  String    @id @default(cuid())
  tenant_id           String
  property_id         String
  /// Litros. Decimal porque o produtor mede em litros com fração.
  liters              Decimal   @db.Decimal(12, 2)
  shift               MilkShift
  recorded_at         DateTime
  group_id            String?
  notes               String?
  cancelled_at        DateTime?
  recorded_by_user_id String?
  created_at          DateTime  @default(now())

  tenant    Tenant         @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  property  Property       @relation(fields: [property_id], references: [id], onDelete: Restrict)
  group     MilkGroup?     @relation(fields: [group_id], references: [id], onDelete: SetNull)
  /// Fase 2: as movimentações que nasceram deste registro (§14, produção que
  /// foi para o tanque). Campo em snake_case como o resto do projeto.
  movements MilkMovement[]

  @@index([tenant_id])
  @@index([property_id, recorded_at])
  @@index([group_id])
}

// ─────────────────────────────────────────────────────────────
// Área Leite, fase 2 (Módulo 32, §12 a §22).
// Ver docs/specs/module-32-area-leite.md, seção 12.
//
// Aqui o leite ganha LUGAR e DONO, e vira o terceiro livro-razão do sistema.
// A posição é `local x dono`, e o volume de cada uma é a soma das
// movimentações que apontam para ela (invariante 2). O §20 cai de graça: o
// tanque com próprio 400, João 300 e Carlos 250 são três posições no mesmo
// local, e o volume físico é a soma delas.
//
// `dono` nulo significa "meu", não "desconhecido": é a mesma escolha do
// `HerdOwner.proprio`, com a diferença de que aqui o outro lado tem nome.
// ─────────────────────────────────────────────────────────────

enum MilkSiteType {
  proprio
  terceiro
}

enum MilkMovementType {
  /// §14: a produção do dia entra no tanque.
  entrada_producao
  /// §19: recebemos leite de um terceiro.
  entrada_terceiro
  /// §16: leite nosso sai do tanque para um ponto de coleta de terceiros.
  transferencia
  /// §15 e §21: o leite sai, com destino declarado.
  saida
  /// Correção de contagem, para o saldo ser consertado sem apagar nada.
  ajuste
}

/// §15: para onde o leite foi quando saiu.
enum MilkDestination {
  venda
  laticinio
  cooperativa
  ponto_coleta
  fabricacao_propria
  alimentacao_bezerros
  consumo
  descarte
  /// §30: leite produzido e não vendido. Os outros seis destinos daquela
  /// seção já existiam na fase 2; este faltava.
  doacao
  outro
}

/// §22: as seis formas de cobrar pelo serviço de ponto de coleta.
enum MilkChargeType {
  por_litro
  por_produtor
  por_coleta
  mensal
  fixo
  outro
}

/// Onde o leite pode estar (§13 e §16). Espelha `ConfinementSite`, que já está
/// em produção com `proprio | boitel`, porque é o mesmo conceito.
///
/// NÃO reusa o `ConfinementSite`: tanque de leite passaria a aparecer nas
/// consultas de confinamento, e as duas áreas ficariam presas uma na outra por
/// uma coincidência de campos, não por um conceito comum.
model MilkSite {
  id        String       @id @default(cuid())
  tenant_id String
  name      String
  type      MilkSiteType

  /// Fazenda, quando `type` é `proprio`. Opcional porque um ponto de coleta de
  /// terceiros não é uma fazenda do tenant.
  property_id String?

  /// Dono do ponto de coleta, quando `type` é `terceiro`. Opcional pelo motivo
  /// espelhado: o tanque próprio não tem contraparte.
  counterparty_name String?
  city              String?
  /// §13: opcional. NÃO é limite: o saldo pode passar dela, e a tela avisa.
  capacity          Int?
  notes             String?

  archived_at DateTime?
  created_at  DateTime  @default(now())

  tenant   Tenant    @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  property Property? @relation(fields: [property_id], references: [id], onDelete: Restrict)

  movements_from MilkMovement[] @relation("MilkMovementFromSite")
  movements_to   MilkMovement[] @relation("MilkMovementToSite")
  charges        MilkCharge[]
  service_jobs   ServiceJob[]

  @@index([tenant_id])
  @@index([property_id])
}

/// O livro-razão do leite. Espelha `HerdMovement`: cada linha declara de onde
/// saiu e para onde foi, e o lado fica nulo quando o leite NASCE (produção) ou
/// SOME (saída para venda, consumo, descarte).
///
/// O saldo de uma posição `(site, owner)` é a soma dos `to` menos a soma dos
/// `from`. Não existe campo de saldo, e não pode existir (invariante 2).
model MilkMovement {
  id            String           @id @default(cuid())
  tenant_id     String
  movement_type MilkMovementType
  liters        Decimal          @db.Decimal(12, 2)
  occurred_at   DateTime

  from_site_id  String?
  /// Nulo = leite próprio. Preenchido = leite daquele produtor (§19, §20).
  from_owner_id String?

  to_site_id  String?
  to_owner_id String?

  /// Só em `saida` (§15). Nas outras o destino é o próprio local.
  destination MilkDestination?

  /// Quando a movimentação nasceu de um registro de produção (§14), aponta
  /// para ele: é o que permite ver que aqueles litros do tanque vieram da
  /// ordenha da manhã, e não de um ajuste.
  production_id String?

  /// §28: para quem a entrega foi, quando ela ainda não virou venda. É este
  /// campo que permite o fechamento por período somar as entregas de UM
  /// comprador sem inventar um model de "entrega" ao lado do livro-razão.
  buyer_id String?

  /// A venda (§23) ou o fechamento (§28) a que esta movimentação pertence.
  /// Nulo numa entrega que ainda não foi liquidada, e é assim que o
  /// fechamento seguinte sabe o que ainda não cobrou: liquidar duas vezes o
  /// mesmo período cobraria o laticínio duas vezes pelo mesmo leite.
  negotiation_id String?

  /// TRUE quando a movimentação NASCEU da venda, e por isso o cancelamento da
  /// venda deve CANCELAR esta linha: aquele leite nunca saiu.
  ///
  /// FALSE quando ela é uma entrega que já existia e só foi liquidada por um
  /// fechamento: aí o cancelamento remove a marca (`negotiation_id`) e a linha
  /// FICA, porque o leite saiu de verdade, só não foi pago. Sem esta
  /// distinção, cancelar um fechamento apagaria entregas que aconteceram.
  created_by_sale Boolean @default(false)

  notes               String?
  canceled_at         DateTime?
  recorded_by_user_id String?
  created_at          DateTime  @default(now())

  tenant      Tenant          @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  from_site   MilkSite?       @relation("MilkMovementFromSite", fields: [from_site_id], references: [id], onDelete: Restrict)
  to_site     MilkSite?       @relation("MilkMovementToSite", fields: [to_site_id], references: [id], onDelete: Restrict)
  buyer       Contact?        @relation("MilkMovementBuyer", fields: [buyer_id], references: [id], onDelete: Restrict)
  negotiation Negotiation?    @relation(fields: [negotiation_id], references: [id], onDelete: SetNull)
  from_owner  Contact?        @relation("MilkMovementFromOwner", fields: [from_owner_id], references: [id], onDelete: Restrict)
  to_owner    Contact?        @relation("MilkMovementToOwner", fields: [to_owner_id], references: [id], onDelete: Restrict)
  production  MilkProduction? @relation(fields: [production_id], references: [id], onDelete: SetNull)

  @@index([tenant_id])
  @@index([from_site_id])
  @@index([to_site_id])
  @@index([occurred_at])
  @@index([production_id])
}

/// §22: a receita de funcionar como ponto de coleta.
///
/// Gesto PRÓPRIO, e não um campo de cada recebimento: o §22 começa com "Caso a
/// fazenda cobre", e formas como `mensal` e `por_produtor` não pertencem a um
/// recebimento isolado.
///
/// O valor é o que o produtor digitou, NUNCA calculado, mesmo quando a forma é
/// `por_litro`. O §22 dá o exemplo de R$ 0,05 sobre 5.000 litros mas não diz
/// sobre qual PERÍODO somar esses litros: isso só aparece no §28, que é a fase
/// 3. Mesma decisão da cobrança do confinamento, que está em produção.
model MilkCharge {
  id           String         @id @default(cuid())
  tenant_id    String
  /// De quem se está cobrando (§19, §22).
  owner_id     String
  site_id      String?
  type         MilkChargeType
  amount       Decimal        @db.Decimal(14, 2)
  occurred_at  DateTime
  /// Texto livre do período coberto ("agosto/2026", "coleta de 12/08"). Não é
  /// intervalo de datas porque o §22 não define apuração, e um intervalo
  /// sugeriria um fechamento que só existe na fase 3.
  period_label String?

  notes               String?
  /// O lançamento gerado em `FinancialEntry`, para o cancelamento alcançá-lo.
  financial_entry_id  String?
  canceled_at         DateTime?
  recorded_by_user_id String?
  created_at          DateTime  @default(now())

  tenant Tenant    @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  owner  Contact   @relation(fields: [owner_id], references: [id], onDelete: Restrict)
  site   MilkSite? @relation(fields: [site_id], references: [id], onDelete: Restrict)

  @@index([tenant_id])
  @@index([owner_id])
}

// ─────────────────────────────────────────────────────────────
// Módulo 33: Mão de Obra, fase 1 (o trabalhador fixo).
// Ver docs/superpowers/specs/2026-09-02-mao-de-obra-e-servicos-com-maquinas-design.md
//
// NÃO é folha de pagamento. Os §35 e §41 do documento do cliente excluem
// eSocial, FGTS, INSS, férias, 13º, rescisão, ponto e banco de horas, e essa
// exclusão é deliberada, não escopo adiado: o §4 diz que o produtor "não deverá
// precisar cadastrar informações trabalhistas complexas para registrar uma
// pessoa".
//
// NENHUM valor pago ou devido mora aqui (invariante 2). O que foi pago é
// `FinancialEntry` com `related_module: mao_de_obra` e `related_id` do
// trabalhador; o que falta pagar é a entrada pendente. `pay_amount` é a única
// exceção aparente, e não é: ele é o valor COMBINADO, dado de ENTRADA, não
// soma. É a mesma razão pela qual `Negotiation.amount` é gravado.
// ─────────────────────────────────────────────────────────────

enum WorkerType {
  /// Relação contínua com a fazenda (§3.1): vaqueiro, tratorista, caseiro.
  fixo
  /// Trabalha por períodos curtos ou diárias (§3.2). Cadastrado aqui quando é
  /// alguém que volta; o diarista de uma vez só não precisa de cadastro, e vira
  /// `worker_count` no `ServiceJob` da fase 33.2.
  eventual
}

enum PayFrequency {
  mensal
  quinzenal
  semanal
  diaria
  outra
}

enum WorkerStatus {
  ativo
  inativo
}

/// Distingue os pagamentos do §9 (adiantamento), §10 (gratificação, hora extra)
/// e §11 (benefícios) do pagamento normal do §7.
enum WorkerEntryKind {
  pagamento
  adiantamento
  gratificacao
  beneficio
  outro
}

model Worker {
  id          String       @id @default(cuid())
  tenant_id   String
  /// Opcional porque o §25 diz que relacionar à propriedade só importa "caso o
  /// produtor possua mais de uma fazenda".
  property_id String?
  name        String
  /// Texto livre, com as dez sugestões do §6 oferecidas na tela. Não é enum
  /// porque a lista do §6 termina em "Outro", e o documento não pede lista
  /// fechada: um "campeiro de apoio" não pode ser recusado pelo cadastro.
  role        String
  type        WorkerType
  status      WorkerStatus @default(ativo)

  /// Nulos no `eventual`: quem trabalha por diária não tem frequência de
  /// pagamento, e o §13 trata a diária como um SERVIÇO, não como salário.
  pay_frequency PayFrequency?
  pay_amount    Decimal?      @db.Decimal(14, 2)
  /// Dia habitual de pagamento (§5). 1 a 31; a previsão cai no último dia do
  /// mês quando o mês não tem o dia escolhido, porque quem escreveu 31 quis
  /// dizer "no fim do mês", não 3 de março.
  pay_day       Int?

  phone      String?
  started_at DateTime?
  notes      String?

  /// Desativar, nunca apagar: mesmo padrão de Property, Pasture e Contact. Um
  /// trabalhador apagado levaria junto a leitura dos pagamentos dele, e o
  /// §40.8 exige histórico.
  archived_at         DateTime?
  recorded_by_user_id String?
  created_at          DateTime  @default(now())
  updated_at          DateTime  @updatedAt

  tenant      Tenant    @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  property    Property? @relation(fields: [property_id], references: [id], onDelete: Restrict)
  recorded_by User?     @relation("WorkerRecordedBy", fields: [recorded_by_user_id], references: [id], onDelete: SetNull)

  /// Fase 33.2: as diárias em que ele entrou, e as anotações do §12 e §34.
  service_jobs ServiceJob[]
  logs         WorkerLog[]

  /// Fase 34.1: os serviços que ele OPEROU (§8), que são outra coisa de
  /// `service_jobs`. Um tratorista pode operar a máquina num serviço prestado
  /// ao vizinho sem ser a contraparte dele: a contraparte ali é o cliente.
  service_jobs_operated ServiceJob[] @relation("ServiceJobOperator")

  @@index([tenant_id])
  /// A listagem principal (§38, "Minha equipe") filtra por situação.
  @@index([tenant_id, status])
  @@index([property_id])
}

// ─────────────────────────────────────────────────────────────
// Módulo 33, fase 2: o serviço contratado de terceiro.
// Ver docs/superpowers/specs/2026-09-02-mao-de-obra-e-servicos-com-maquinas-design.md
//
// NENHUM SALDO MORA AQUI (invariante 2). `unit_price` e `agreed_amount` são o
// COMBINADO, dado de entrada, não soma: mesma razão de `Negotiation.amount` e
// de `Worker.pay_amount`. A quantidade é soma de `ServiceJobLog`, o total é
// derivado dela, e o pago e o restante são somas de `FinancialEntry`.
//
// ⚠️ Os três podem divergir, e isso é informação, não defeito: o produtor pode
// editar um lançamento em `/financeiro`, e é ali que o dinheiro de verdade
// mora. A tela mostra os três lado a lado para a divergência aparecer.
// ─────────────────────────────────────────────────────────────

enum ServiceDirection {
  /// A fazenda CONTRATA (§15 a §18 da Mão de Obra, §29 de Máquinas). Despesa.
  contratado
  /// A fazenda PRESTA com máquina própria (§3.1 de Máquinas). Receita.
  /// Só a fase 34.1 escreve este valor; ele nasce aqui para o enum não crescer
  /// depois, o que exigiria migração numa tabela já cheia.
  prestado
}

/// As nove formas de cobrança: a união do §16 da Mão de Obra com o §11 de
/// Máquinas. `fechado` é o empreito do §15, e é o único em que `unit_price`
/// não se aplica.
enum ServicePricing {
  hora
  hectare
  dia
  viagem
  tonelada
  metro
  quilometro
  cabeca
  fechado
}

enum ServiceJobStatus {
  agendado
  em_andamento
  concluido
  cancelado
}

/// §12 (atividade realizada) e §34 (falta, folga, férias, afastamento) num
/// modelo só. Os dois são "uma anotação com data sobre um trabalhador", e o
/// documento é explícito que nenhum dos dois calcula nada.
enum WorkerLogKind {
  atividade
  falta
  folga
  ferias
  afastamento
}

model ServiceJob {
  id          String           @id @default(cuid())
  tenant_id   String
  property_id String
  direction   ServiceDirection @default(contratado)
  status      ServiceJobStatus @default(agendado)
  occurred_at DateTime
  /// O que foi feito: "Reforma de cerca", "Roçada". Texto livre, com as 19
  /// sugestões do §20 oferecidas na tela, pelo mesmo motivo de `Worker.role`.
  description String

  pricing       ServicePricing
  /// Nulo quando `pricing` é `fechado`.
  unit_price    Decimal?       @db.Decimal(14, 2)
  /// Só quando `pricing` é `fechado`: o valor combinado do empreito (§15).
  agreed_amount Decimal?       @db.Decimal(14, 2)

  /// §14: "vieram 3 homens". Multiplica o VALOR, nunca a quantidade: o §14 diz
  /// que 3 homens por 4 dias são "12 diárias", mas o serviço durou 4 dias, e
  /// somar 12 na quantidade faria a tela dizer que a cerca levou doze dias.
  worker_count Int @default(1)

  /// A contraparte. Os dois nulos no caso dos três homens sem nome do §14.
  contact_id String?
  worker_id  String?

  /// §25, §26, §27 e §28: onde o trabalho aconteceu, e a que ele pertence.
  pasture_id          String?
  confinement_stay_id String?
  milk_site_id        String?

  /// A máquina que fez o serviço. OBRIGATÓRIA no `prestado` (§17), e o §32
  /// depende dela para o histórico. RECUSADA no `contratado`: a máquina de um
  /// terceiro nem está nesta tabela, e manutenção de máquina é
  /// `MachineMaintenance`, que já tem data, descrição e custo, e já gera
  /// lançamento (decisão 10 da spec).
  machine_id String?

  /// §10: ONDE o serviço aconteceu, quando foi fora daqui.
  ///
  /// `property_id` continua obrigatório e significa DE QUAL FAZENDA A MÁQUINA
  /// SAIU, que é informação real e útil. Este campo guarda o nome da fazenda e
  /// o município do cliente, que o §10 lista como opcionais.
  ///
  /// ⚠️ NÃO é uma `Property`: cadastrar a fazenda do vizinho poluiria Minha
  /// Fazenda e ofereceria ao rebanho, ao confinamento e ao leite um destino que
  /// não existe. E `property_id` não virou anulável de propósito: a coluna
  /// ficaria anulável para TODOS os serviços, e o filtro por fazenda ganharia
  /// um caso que ninguém lembra de tratar. Ver a decisão 13 da spec.
  client_location String?

  /// §7 de Máquinas: grade, arado, plantadeira. Texto livre e opcional, porque
  /// o documento diz "o preenchimento será opcional" e a lista termina em
  /// "Outro". Implemento não é modelo próprio: ele não tem histórico, custo nem
  /// manutenção separada da máquina que o puxa.
  implement String?

  /// §8: quem operou a máquina.
  ///
  /// A FK cobre funcionário fixo e diarista, que é o "reutilizar o mesmo
  /// cadastro" que o §8 pede em letra e o §36 repete. O texto cobre "próprio
  /// produtor", "outro" e o avulso. Três colunas (worker, contact e texto)
  /// foram descartadas: toda leitura checaria as três na ordem certa, e o
  /// prestador que OPERA a máquina é caso raro, porque normalmente ele é o dono
  /// do serviço. Ver a decisão 14 da spec.
  operator_worker_id String?
  operator_note      String?

  notes String?

  canceled_at         DateTime?
  canceled_reason     String?
  canceled_by_user_id String?
  recorded_by_user_id String?
  created_at          DateTime  @default(now())
  updated_at          DateTime  @updatedAt

  tenant           Tenant          @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  property         Property        @relation(fields: [property_id], references: [id], onDelete: Restrict)
  contact          Contact?        @relation(fields: [contact_id], references: [id], onDelete: SetNull)
  worker           Worker?         @relation(fields: [worker_id], references: [id], onDelete: SetNull)
  pasture          Pasture?        @relation(fields: [pasture_id], references: [id], onDelete: SetNull)
  confinement_stay HerdStay?       @relation(fields: [confinement_stay_id], references: [id], onDelete: SetNull)
  milk_site        MilkSite?       @relation(fields: [milk_site_id], references: [id], onDelete: SetNull)
  machine          Machine?        @relation(fields: [machine_id], references: [id], onDelete: SetNull)
  operator         Worker?         @relation("ServiceJobOperator", fields: [operator_worker_id], references: [id], onDelete: SetNull)
  recorded_by      User?           @relation("ServiceJobRecordedBy", fields: [recorded_by_user_id], references: [id], onDelete: SetNull)
  canceled_by      User?           @relation("ServiceJobCanceledBy", fields: [canceled_by_user_id], references: [id], onDelete: SetNull)
  logs             ServiceJobLog[]

  @@index([tenant_id])
  @@index([tenant_id, status])
  @@index([tenant_id, occurred_at])
  /// A junção que o custo do lote de confinamento usa (decisão 12 da spec).
  @@index([confinement_stay_id])
  @@index([contact_id])
  @@index([worker_id])
  /// O histórico da máquina (§32) e o operador (§8) são consultados por aqui.
  @@index([machine_id])
  @@index([operator_worker_id])
}

/// A quantidade trabalhada, que é SEMPRE soma.
///
/// Um serviço de tiro único cria uma linha só. O §19 permite vários dias e o
/// §20 permite acrescentar "fiz 8 hectares hoje" ao serviço em andamento, e a
/// tela disso chega na fase 34.2; o modelo nasce agora para não haver migração
/// de dado de produção depois.
model ServiceJobLog {
  id             String    @id @default(cuid())
  tenant_id      String
  service_job_id String
  occurred_at    DateTime
  quantity       Decimal   @db.Decimal(14, 3)
  notes          String?
  /// Cancelar não apaga: para de contar e mantém a linha, como em HerdMovement.
  canceled_at    DateTime?
  created_at     DateTime  @default(now())

  service_job ServiceJob @relation(fields: [service_job_id], references: [id], onDelete: Cascade)

  @@index([tenant_id])
  @@index([service_job_id])
}

/// A anotação simples do §12 e do §34.
///
/// O §12 diz "o objetivo não será controlar cada minuto do trabalhador" e o §34
/// diz que o TIBÉ "não deverá calcular automaticamente consequências
/// trabalhistas". Nada aqui alimenta cálculo nenhum: é data, tipo e descrição.
/// Em particular, uma falta NÃO gera desconto.
model WorkerLog {
  id          String        @id @default(cuid())
  tenant_id   String
  worker_id   String
  kind        WorkerLogKind
  occurred_at DateTime
  description String?
  property_id String?
  pasture_id  String?
  created_at  DateTime      @default(now())

  tenant   Tenant    @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  worker   Worker    @relation(fields: [worker_id], references: [id], onDelete: Cascade)
  property Property? @relation(fields: [property_id], references: [id], onDelete: SetNull)
  pasture  Pasture?  @relation(fields: [pasture_id], references: [id], onDelete: SetNull)

  @@index([tenant_id])
  @@index([worker_id])
}
