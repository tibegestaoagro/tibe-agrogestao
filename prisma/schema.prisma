// Tibé (AgroGestão) — schema multi-tenant
// Modelo de dados: PRD seção 4. Isolamento por tenant_id: PRD seção 10.4.
//
// Convenções:
// - Modelos em PascalCase, campos em snake_case (espelham os contratos de API do PRD).
// - Todo modelo de negócio carrega `tenant_id` e é coberto pelo middleware de isolamento
//   (lib/prisma.ts), EXCETO os modelos-filho que herdam o tenant via relação com o pai
//   (AnimalWeightLog, AnimalVaccination, AnimalMovement, CropCycle, PlotInput) e o
//   PlatformUser, que vive fora do isolamento por desenho (PRD seção 4 e 10.4).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────────────────────────
// Enums
// ─────────────────────────────────────────────────────────────

enum TenantPlan {
  campo
  fazenda
  grupo
}

enum TenantStatus {
  trial
  active
  suspended
  canceled
}

enum PlatformRole {
  MASTER_ADMIN
  EQUIPE
}

enum ProfileType {
  fazenda
  prestador
}

// Roles de tenant em MAIÚSCULAS conforme spec 0.6 e contrato POST /api/auth/login.
enum UserRole {
  OWNER
  ADMIN
  OPERADOR
  VISUALIZADOR
}

enum AnimalStatus {
  active
  sold
  deceased
}

enum AnimalSex {
  male
  female
}

enum MovementType {
  purchase
  sale
  transfer
  death
}

enum CropCycleStatus {
  planted
  growing
  harvested
}

enum InputType {
  fertilizer
  pesticide
  seed
}

enum PricingType {
  hour
  day
  fixed
}

enum ServiceOrderStatus {
  scheduled
  completed
  invoiced
}

enum EntryType {
  income
  expense
}

enum RelatedModule {
  rebanho
  lavoura
  servico
  geral
}

enum FinancialEntryStatus {
  pending
  paid
  overdue
}

enum MessageDirection {
  in
  out
}

enum AlertType {
  vaccine_due
  harvest_near
  bill_due
  low_balance
  trial_ending // spec 5.8 — não previsto no PRD original, extensão aditiva
}

enum AlertStatus {
  pending
  sent
  dismissed
}

// Arquitetura 2026-07-29: canal de email (Gmail SMTP em dev, Resend depois
// que o domínio próprio existir), somando ao WhatsApp já existente. Todo
// envio grava uma linha aqui, sucesso ou falha: rastro auditável exigido
// pelo usuário (avisos de fatura/trial precisam de comprovação, não podem
// depender só do WhatsApp).
enum EmailLogType {
  welcome
  alert
  password_reset
}

enum EmailLogStatus {
  sent
  failed
}

// Arquitetura 2026-07-29: recuperação de senha (código de 6 dígitos por
// email ou WhatsApp, escolha do usuário no pedido). Só para User de tenant
// (PlatformUser fica de fora, decisão deliberada: conta sensível demais pra
// self-service, equipe pequena da Pleno Digital).
enum PasswordResetChannel {
  email
  whatsapp
}

enum SubscriptionStatus {
  active
  overdue
  canceled
}

// ─────────────────────────────────────────────────────────────
// Núcleo multi-tenant
// ─────────────────────────────────────────────────────────────

model Tenant {
  id            String       @id @default(cuid())
  name          String
  document      String       @unique // CNPJ ou CPF
  phone         String?
  email         String?
  plan          TenantPlan
  // Tenants criados manualmente pelo painel (spec 2026-07-27) nascem sem
  // plano escolhido pelo cliente — plan carrega um default interno até o
  // cliente confirmar no primeiro login. Tenants do signup público (que já
  // escolhem o plano em /planos antes de criar a conta) nascem com true.
  plan_confirmed Boolean     @default(true)
  status        TenantStatus @default(trial)
  trial_ends_at DateTime?
  // Arquivamento pelo painel da plataforma (spec 2026-07-27) — nunca deleta,
  // mesmo padrão de Property.archived_at (M1). Idempotente.
  archived_at   DateTime?

  // Origem do lead (UTM) — PRD seção 4 / v1.1
  lead_source_utm_source   String?
  lead_source_utm_medium   String?
  lead_source_utm_campaign String?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  profiles          TenantProfile[]
  users             User[]
  properties        Property[]
  animals           Animal[]
  vaccines          Vaccine[]
  plots             Plot[]
  service_clients   ServiceClient[]
  services          Service[]
  service_orders    ServiceOrder[]
  financial_entries FinancialEntry[]
  whatsapp_contacts WhatsAppContact[]
  conversation_logs AgentConversationLog[]
  alerts            Alert[]
  email_logs        EmailLog[]
  password_resets   PasswordResetCode[]
  agent_flows       AgentFlowState[]
  refresh_tokens    RefreshToken[]
  subscription      Subscription?
}

// Equipe da Pleno Digital. NÃO carrega tenant_id — fora do isolamento (PRD 4 / 10.4).
model PlatformUser {
  id            String       @id @default(cuid())
  name          String
  email         String       @unique
  password_hash String
  role          PlatformRole @default(EQUIPE)
  created_at    DateTime     @default(now())
  active        Boolean      @default(true)

  status_changes SubscriptionStatusLog[]
}

model TenantProfile {
  id           String      @id @default(cuid())
  tenant_id    String
  profile_type ProfileType
  active       Boolean     @default(true)
  created_at   DateTime    @default(now())

  tenant Tenant @relation(fields: [tenant_id], references: [id], onDelete: Cascade)

  @@unique([tenant_id, profile_type])
  @@index([tenant_id])
}

model User {
  id            String   @id @default(cuid())
  tenant_id     String
  name          String
  // Email globalmente único: o contrato POST /api/auth/login recebe apenas
  // email+senha (sem seletor de tenant), então o email resolve um único usuário.
  email         String   @unique
  password_hash String
  role          UserRole @default(OPERADOR)
  phone         String?
  created_at    DateTime @default(now())
  active        Boolean  @default(true)
  must_change_password Boolean @default(false)

  tenant             Tenant              @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  whatsapp_contacts  WhatsAppContact[]
  password_resets    PasswordResetCode[]
  agent_flows        AgentFlowState[]
  refresh_tokens     RefreshToken[]

  @@index([tenant_id])
}

// Sessão do aplicativo (identidade por token, Onda 1). O access token é um JWT
// curto (15 min) que NÃO é persistido; só o refresh token vive aqui, e só como
// hash: o valor em claro existe uma única vez, na resposta ao aplicativo.
//
// `tenant_id` está aqui pelo mesmo motivo dos demais modelos de negócio
// (defense-in-depth: entra em TENANT_SCOPED_MODELS), NÃO para servir de
// autoridade de tenant ao autenticar. Quem responde "de qual tenant é esta
// requisição" continua sendo a linha de `User` resolvida pelo `user_id`.
//
// `token_hash` é único: é por ele que a renovação encontra a linha antes de
// saber o tenant, e é o índice que sustenta o uso único (revoked_at).
model RefreshToken {
  id         String    @id @default(cuid())
  tenant_id  String
  user_id    String
  token_hash String    @unique
  expires_at DateTime
  revoked_at DateTime?
  created_at DateTime  @default(now())

  tenant Tenant @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([tenant_id])
  @@index([user_id])
}

// Recuperação de senha (arquitetura 2026-07-29). code_hash: nunca em claro,
// mesmo padrão de senha (bcrypt). O próprio `id` (cuid, não-adivinhável) é a
// referência que a UI carrega entre as 3 telas (pedir → validar → nova
// senha), sem precisar de um token assinado à parte. `verified_at` prova que
// a etapa de validação aconteceu antes de aceitar a troca de senha;
// `consumed_at` fecha o ciclo e impede reuso do mesmo código já validado.
model PasswordResetCode {
  id          String               @id @default(cuid())
  tenant_id   String
  user_id     String
  code_hash   String
  channel     PasswordResetChannel
  attempts    Int                  @default(0)
  verified_at DateTime?
  consumed_at DateTime?
  expires_at  DateTime
  created_at  DateTime             @default(now())

  tenant Tenant @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([tenant_id])
  @@index([user_id])
}

// Cadastro público em andamento (Módulo 19). FORA de TENANT_SCOPED_MODELS por
// necessidade estrutural: o Tenant ainda não existe quando a linha nasce, e é
// justamente esse o ponto (cadastro abandonado não pode virar tenant nem travar
// o CPF/CNPJ do dono real). Mesma categoria de PlatformUser e
// WhatsAppProviderConfig. Toda leitura é pelo `id` da própria linha, entregue
// ao navegador por cookie httpOnly, nunca por email/telefone vindo do client.
model PendingSignup {
  id           String     @id @default(cuid())
  company_name String
  owner_name   String
  owner_email  String
  document     String
  phone        String
  plan         TenantPlan

  whatsapp_code_hash       String
  whatsapp_code_expires_at DateTime
  whatsapp_attempts        Int       @default(0)
  whatsapp_verified_at     DateTime?

  email_code_hash       String?
  email_code_expires_at DateTime?
  email_attempts        Int       @default(0)
  email_verified_at     DateTime?

  utm_source   String?
  utm_medium   String?
  utm_campaign String?

  created_at DateTime @default(now())
  expires_at DateTime

  @@index([document])
  @@index([expires_at])
}

// Cadastro assistido em andamento pelo WhatsApp (2026-07-30). Existe porque o
// agente era SEM ESTADO: o contexto vinha do `recent_history` (5 interacoes), o
// que sustenta um "sim/nao" mas nao um formulario de varios campos vezes varios
// animais, onde a primeira resposta sai da janela antes do fim.
//
// Nada e gravado no rebanho antes da confirmacao final: os itens ficam aqui, em
// `completed_items`, e so viram Animal quando o usuario confirma o resumo. O
// risco de perder trabalho no meio e coberto pelo lembrete de abandono, que le
// `updated_at` e `reminded_at`.
model AgentFlowState {
  id              String    @id @default(cuid())
  tenant_id       String
  user_id         String
  flow            String
  target_count    Int       @default(1)
  completed_items Json      @default("[]")
  current_item    Json      @default("{}")
  pending_field   String?
  awaiting_summary Boolean  @default(false)
  reminded_at     DateTime?
  expires_at      DateTime
  created_at      DateTime  @default(now())
  updated_at      DateTime  @updatedAt

  tenant Tenant @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [user_id], references: [id], onDelete: Cascade)

  // Um cadastro em andamento por usuario: dois formularios paralelos na mesma
  // conversa de texto seriam impossiveis de acompanhar.
  @@unique([tenant_id, user_id])
  @@index([tenant_id])
  @@index([expires_at])
}

model Property {
  id            String    @id @default(cuid())
  tenant_id     String
  name          String
  address       String?
  area_hectares Decimal?  @db.Decimal(12, 2)
  archived_at   DateTime? // arquivamento (1.1): não deletar, preservar histórico
  created_at    DateTime  @default(now())

  tenant         Tenant           @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  animals        Animal[]
  plots          Plot[]
  movements_from AnimalMovement[] @relation("MovementFromProperty")
  movements_to   AnimalMovement[] @relation("MovementToProperty")

  @@index([tenant_id])
}

// ─────────────────────────────────────────────────────────────
// Módulo Rebanho
// ─────────────────────────────────────────────────────────────

model Animal {
  id             String       @id @default(cuid())
  tenant_id      String
  property_id    String
  ear_tag        String
  breed          String?
  sex            AnimalSex
  birth_date     DateTime?
  status         AnimalStatus @default(active)
  current_weight Decimal?     @db.Decimal(10, 3)
  created_at     DateTime     @default(now())
  updated_at     DateTime     @updatedAt

  tenant       Tenant              @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  property     Property            @relation(fields: [property_id], references: [id], onDelete: Restrict)
  weight_logs  AnimalWeightLog[]
  vaccinations AnimalVaccination[]
  movements    AnimalMovement[]

  @@unique([tenant_id, ear_tag])
  @@index([tenant_id])
  @@index([property_id])
}

// tenant_id incluído para entrar no middleware de isolamento (decisão M1).
model AnimalWeightLog {
  id          String   @id @default(cuid())
  tenant_id   String
  animal_id   String
  weight      Decimal  @db.Decimal(10, 3)
  measured_at DateTime
  created_at  DateTime @default(now())

  animal Animal @relation(fields: [animal_id], references: [id], onDelete: Cascade)

  @@index([tenant_id])
  @@index([animal_id])
}

model Vaccine {
  id                    String @id @default(cuid())
  tenant_id             String
  name                  String
  default_interval_days Int?

  tenant       Tenant              @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  vaccinations AnimalVaccination[]

  @@index([tenant_id])
}

// tenant_id incluído para entrar no middleware de isolamento (decisão M1).
model AnimalVaccination {
  id          String    @id @default(cuid())
  tenant_id   String
  animal_id   String
  vaccine_id  String
  applied_at  DateTime
  next_due_at DateTime?
  cost        Decimal?  @db.Decimal(14, 2) // custo opcional → gera FinancialEntry (1.4/1.6)
  created_at  DateTime  @default(now())

  animal  Animal  @relation(fields: [animal_id], references: [id], onDelete: Cascade)
  vaccine Vaccine @relation(fields: [vaccine_id], references: [id], onDelete: Restrict)

  @@index([tenant_id])
  @@index([animal_id])
  @@index([vaccine_id])
}

// tenant_id incluído para entrar no middleware de isolamento (decisão M1).
model AnimalMovement {
  id               String       @id @default(cuid())
  tenant_id        String
  animal_id        String
  movement_type    MovementType
  from_property_id String?
  to_property_id   String?
  value            Decimal?     @db.Decimal(14, 2)
  notes            String?
  occurred_at      DateTime
  created_at       DateTime     @default(now())

  animal        Animal    @relation(fields: [animal_id], references: [id], onDelete: Cascade)
  from_property Property? @relation("MovementFromProperty", fields: [from_property_id], references: [id], onDelete: SetNull)
  to_property   Property? @relation("MovementToProperty", fields: [to_property_id], references: [id], onDelete: SetNull)

  @@index([tenant_id])
  @@index([animal_id])
}

// ─────────────────────────────────────────────────────────────
// Módulo Lavoura
// ─────────────────────────────────────────────────────────────

model Plot {
  id            String   @id @default(cuid())
  tenant_id     String
  property_id   String
  name          String
  area_hectares Decimal? @db.Decimal(12, 2)
  current_crop  String?
  created_at    DateTime @default(now())

  tenant   Tenant      @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  property Property    @relation(fields: [property_id], references: [id], onDelete: Restrict)
  cycles   CropCycle[]

  @@index([tenant_id])
  @@index([property_id])
}

// tenant_id incluído para entrar no middleware de isolamento (decisão M1).
model CropCycle {
  id                  String          @id @default(cuid())
  tenant_id           String
  plot_id             String
  crop_name           String
  planted_at          DateTime?
  expected_harvest_at DateTime?
  harvested_at        DateTime?
  yield_amount        Decimal?        @db.Decimal(14, 3)
  yield_unit          String?
  status              CropCycleStatus @default(planted)
  created_at          DateTime        @default(now())

  plot   Plot        @relation(fields: [plot_id], references: [id], onDelete: Cascade)
  inputs PlotInput[]

  @@index([tenant_id])
  @@index([plot_id])
}

// tenant_id incluído para entrar no middleware de isolamento (decisão M1).
model PlotInput {
  id         String    @id @default(cuid())
  tenant_id  String
  cycle_id   String
  input_type InputType
  name       String
  quantity   Decimal?  @db.Decimal(14, 3)
  unit       String?
  cost       Decimal?  @db.Decimal(14, 2)
  applied_at DateTime?
  created_at DateTime  @default(now())

  cycle CropCycle @relation(fields: [cycle_id], references: [id], onDelete: Cascade)

  @@index([tenant_id])
  @@index([cycle_id])
}

// ─────────────────────────────────────────────────────────────
// Módulo Prestador de Serviço
// ─────────────────────────────────────────────────────────────

model ServiceClient {
  id         String   @id @default(cuid())
  tenant_id  String
  name       String
  document   String?
  phone      String?
  email      String?
  notes      String?
  created_at DateTime @default(now())

  tenant         Tenant         @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  service_orders ServiceOrder[]

  @@index([tenant_id])
}

model Service {
  id           String      @id @default(cuid())
  tenant_id    String
  name         String
  pricing_type PricingType
  unit_price   Decimal     @db.Decimal(14, 2)
  created_at   DateTime    @default(now())

  tenant         Tenant         @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  service_orders ServiceOrder[]

  @@index([tenant_id])
}

model ServiceOrder {
  id                String             @id @default(cuid())
  tenant_id         String
  service_client_id String
  service_id        String
  description       String?
  quantity          Decimal?           @db.Decimal(14, 3)
  total_value       Decimal?           @db.Decimal(14, 2)
  performed_at      DateTime?
  status            ServiceOrderStatus @default(scheduled)
  created_at        DateTime           @default(now())

  tenant         Tenant        @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  service_client ServiceClient @relation(fields: [service_client_id], references: [id], onDelete: Restrict)
  service        Service       @relation(fields: [service_id], references: [id], onDelete: Restrict)

  @@index([tenant_id])
  @@index([service_client_id])
  @@index([service_id])
}

// ─────────────────────────────────────────────────────────────
// Módulo Financeiro (compartilhado entre perfis)
// ─────────────────────────────────────────────────────────────

model FinancialEntry {
  id             String               @id @default(cuid())
  tenant_id      String
  entry_type     EntryType
  category       String?
  amount         Decimal              @db.Decimal(14, 2)
  related_module RelatedModule        @default(geral)
  related_id     String?
  due_date       DateTime?
  paid_at        DateTime?
  status         FinancialEntryStatus @default(pending)
  notes          String?
  created_at     DateTime             @default(now())

  tenant Tenant @relation(fields: [tenant_id], references: [id], onDelete: Cascade)

  @@index([tenant_id])
}

// ─────────────────────────────────────────────────────────────
// Agente WhatsApp
// ─────────────────────────────────────────────────────────────

model WhatsAppContact {
  id                  String    @id @default(cuid())
  tenant_id           String
  phone               String
  user_id             String?
  last_interaction_at DateTime?
  created_at          DateTime  @default(now())

  tenant Tenant                 @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  user   User?                  @relation(fields: [user_id], references: [id], onDelete: SetNull)
  logs   AgentConversationLog[]

  @@unique([tenant_id, phone])
  @@index([tenant_id])
}

model AgentConversationLog {
  id                  String           @id @default(cuid())
  tenant_id           String
  whatsapp_contact_id String
  direction           MessageDirection
  message_type        String?
  content             String?
  intent_detected     String?
  action_taken        String?
  created_at          DateTime         @default(now())

  tenant           Tenant          @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  whatsapp_contact WhatsAppContact @relation(fields: [whatsapp_contact_id], references: [id], onDelete: Cascade)

  @@index([tenant_id])
  @@index([whatsapp_contact_id])
}

// ─────────────────────────────────────────────────────────────
// Alertas
// ─────────────────────────────────────────────────────────────

model Alert {
  id             String         @id @default(cuid())
  tenant_id      String
  alert_type     AlertType
  related_module RelatedModule?
  related_id     String?
  message        String
  status         AlertStatus    @default(pending)
  scheduled_for  DateTime?
  sent_at        DateTime?
  created_at     DateTime       @default(now())

  tenant Tenant @relation(fields: [tenant_id], references: [id], onDelete: Cascade)

  @@index([tenant_id])
}

model EmailLog {
  id         String         @id @default(cuid())
  tenant_id  String
  to_email   String
  type       EmailLogType
  related_id String? // Alert.id quando type=alert; null para welcome
  status     EmailLogStatus
  error      String?
  sent_at    DateTime?
  created_at DateTime       @default(now())

  tenant Tenant @relation(fields: [tenant_id], references: [id], onDelete: Cascade)

  @@index([tenant_id])
}

// ─────────────────────────────────────────────────────────────
// Cobrança (Asaas)
// ─────────────────────────────────────────────────────────────

model Subscription {
  id                    String             @id @default(cuid())
  tenant_id             String             @unique
  asaas_customer_id     String?
  asaas_subscription_id String?
  plan                  TenantPlan
  status                SubscriptionStatus @default(active)
  next_due_date         DateTime?
  created_at            DateTime           @default(now())

  tenant       Tenant                   @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  status_logs  SubscriptionStatusLog[]

  @@index([tenant_id])
}

// Histórico de toda transição de status de uma assinatura (Módulo 6, task 6.5/
// 6.7/6.9). Não existia até o M6 — sem isso, "cancelamentos no período" e
// "tempo médio de conversão trial→pago" são impossíveis de calcular, e a 6.9
// já exigia um log de auditoria para mudança manual de status. Um único
// mecanismo cobre as duas necessidades: toda vez que Subscription.status muda
// (webhook do Asaas OU ação manual de um master_admin), grava-se uma linha
// aqui. changed_by_platform_user_id nulo = mudança automática (webhook).
model SubscriptionStatusLog {
  id                           String              @id @default(cuid())
  subscription_id              String
  from_status                  SubscriptionStatus?
  to_status                    SubscriptionStatus
  changed_by_platform_user_id  String?
  reason                       String?
  created_at                   DateTime            @default(now())

  subscription Subscription  @relation(fields: [subscription_id], references: [id], onDelete: Cascade)
  changed_by   PlatformUser? @relation(fields: [changed_by_platform_user_id], references: [id], onDelete: SetNull)

  @@index([subscription_id])
  @@index([to_status])
}

// ─────────────────────────────────────────────────────────────
// Config de provider WhatsApp (spec 2026-07-11) — GLOBAL da plataforma,
// fora de TENANT_SCOPED_MODELS (mesma categoria de PlatformUser). Os dois
// providers podem existir configurados em paralelo; no máximo 1 active
// (garantido por transação na ativação + partial unique index na migração).
// credentials_encrypted = JSON criptografado com AES-256-GCM
// (src/lib/crypto-config.ts, chave em CONFIG_ENCRYPTION_KEY).
// ─────────────────────────────────────────────────────────────

enum WhatsAppProvider {
  evolution
  meta_cloud_api
}

model WhatsAppProviderConfig {
  id                    String           @id @default(cuid())
  provider              WhatsAppProvider @unique
  active                Boolean          @default(false)
  credentials_encrypted String
  updated_at            DateTime         @updatedAt
  created_at            DateTime         @default(now())
}
