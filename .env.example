# ─────────────────────────────────────────────────────────────
# Tibé (AgroGestão) — variáveis de ambiente
# Copie este arquivo para .env (local) e preencha os valores.
# Nunca commite .env — apenas este .env.example é versionado.
# Referência: PRD seção 10.2
# ─────────────────────────────────────────────────────────────

# Banco de dados (Neon.tech, PostgreSQL 17)
# Connection string com SSL. Use a "pooled" para a app e a "direct" para migrations se desejar.
DATABASE_URL=

# NextAuth v5
# NEXTAUTH_SECRET: gere com `openssl rand -base64 32`
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# Sessão da plataforma interna (Módulo 6, PlatformUser) — instância NextAuth
# separada da de tenant acima, com secret próprio de propósito (defense in
# depth: mesmo que um token vaze, não é válido para a outra instância).
# Gere com `openssl rand -base64 32` (use um valor DIFERENTE do NEXTAUTH_SECRET).
PLATFORM_AUTH_SECRET=

# Redis Cloud (BullMQ — fila de jobs)
REDIS_URL=

# WhatsApp Business Cloud API (Meta)
META_WHATSAPP_TOKEN=
META_WHATSAPP_PHONE_ID=
META_WHATSAPP_VERIFY_TOKEN=

# N8N (orquestração do agente WhatsApp) — secret de autenticação do webhook
N8N_WEBHOOK_SECRET=

# N8N — URL do webhook que recebe alertas para envio via WhatsApp (Tibé -> N8N,
# outbound). Sem isso configurado, alertas ficam com status "pending" (não quebra
# nada). Ver docs/n8n-whatsapp-workflow.md.
N8N_ALERT_WEBHOOK_URL=

# Asaas (cobrança)
ASAAS_API_KEY=
ASAAS_ENV=sandbox
# Token que você mesmo escolhe e cadastra no painel do Asaas ao criar o
# webhook (Configurações > Integrações > Webhooks) — o Asaas ecoa esse valor
# no header `asaas-access-token` em toda notificação, para autenticação.
ASAAS_WEBHOOK_TOKEN=

# Cloudflare R2 (storage)
CLOUDFLARE_R2_ACCESS_KEY=
CLOUDFLARE_R2_SECRET_KEY=
CLOUDFLARE_R2_BUCKET=

# Secret para rotas internas (/api/internal/*)
INTERNAL_API_SECRET=

# Vercel Cron: valor do Authorization: Bearer enviado automaticamente pela
# Vercel nas rotas de cron (configuradas em vercel.json). Defina o mesmo valor
# em Project Settings > Environment Variables — a Vercel injeta o header sozinha.
CRON_SECRET=
